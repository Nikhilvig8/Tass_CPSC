
@{
    ViewBag.Title = "DelayedData_Actual";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">

        <div class="portlet light bordered" id="form_wizard_1">
            <div class="portlet-title" style="min-height:30px; margin-bottom:0px;">
                <div class="caption" style="padding:0px 0;">
                    <i class="icon-layers font-blue"></i>
                    <span class="caption-subject font-blue bold uppercase">
                        Delayed Entry Report - Target
                    </span>

                </div>


                <div class="btn-group pull-right" style=" margin-top -8px;">
                    <button class="btn green btn-outline dropdown-toggle" data-toggle="dropdown">
                        Tools
                        <i class="fa fa-angle-down"></i>
                    </button>
                    <ul class="dropdown-menu pull-right">
                        <li>
                            <a id="Print"> Print </a>
                        </li>
                        <li>
                            <a id="ExcelExport"> Export to Excel </a>
                        </li>
                        @*<li>
                                <a id="Exporttopdf"> Export to Pdf </a>
                            </li>*@
                    </ul>
                </div>

            </div>
            <div class="portlet-body form" style="overflow:auto; max-height:425px;">
                <div class="form-horizontal">
                    <div class="form-wizard" style="width:99%;">
                        <div class="form-body" style="padding:5px;">

                            <div class="tab-pane active" id="tab1">
                                <!--h3 class="block">Provide your account details</h3-->



                                <table id="sample_editable_1" class="table table-striped table-bordered display" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="font-size:11px;">SPM/SSM</th>
                                            <th style="font-size:11px;">TSM/CSM</th>
                                            <th style="font-size:11px;">Dealer</th>
                                            <th style="font-size:11px;">Division</th>
                                            <th style="font-size:11px;">LOB</th>
                                            <th style="font-size:11px;">Parameter</th>
                                            <th style="font-size:11px;">Sales/AfterSales</th>
                                            <th style="font-size:11px;">Actual</th>
                                            <th style="font-size:11px;">Entry Date</th>

                                        </tr>
                                    </thead>
                                    <tbody>


                                        @using System.Data;
                                        @using System.Data.SqlClient;
                                        @using System.Globalization;
                                        @using System.Web;
                                        @using DataUtilityLayer;
                                        @using System.Configuration;
                                        @{
                                            SqlCommand cmdObj = new SqlCommand();
                                            string uid2 = Session["Uid"].ToString();
                                            string sheet = "Target";
                                            string CS1 = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;
                                            DataTable dtf2;
                                            string _sql2 = string.Empty;
                                            _sql2 = @"getDelayedData";
                                            using (SqlConnection cn = new SqlConnection(CS1))
                                            {
                                                DataTable dt = new DataTable();
                                                //var cmd = new SqlCommand(_sql, cn);
                                                var daCampus = new SqlDataAdapter(_sql2, cn);
                                                daCampus.SelectCommand.CommandType = CommandType.StoredProcedure;
                                                daCampus.SelectCommand.Parameters.AddWithValue("@FW", Session["Uid"].ToString());
                                                daCampus.SelectCommand.Parameters.AddWithValue("@ForActual_Target", sheet);
                                                daCampus.Fill(dt);
                                                dtf2 = dt;
                                            }

                                        }


                                        @{if (dtf2.Rows.Count > 0)
                                            {
                                                for (int i = 0; i < dtf2.Rows.Count; i++)
                                                {
                                                    <tr>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["SPM_SSM"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["TSM_CSM"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Dealer_Name"].ToString() - @dtf2.Rows[i]["City"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Division_Id"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["LOB"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["KPI_NAME"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["dept"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Actual_Value"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Entry_Date_Actual"].ToString()</td>

                                                    </tr>
                                    <!-- row 1 end-->
                                    <!-- row 2 start-->
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>



                        </div>
                    </div>
                    <!--col-md-offset-7 -->



                </div>



            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function () {



    $("#sample_editable_1").dataTable({
        "bPaginate": false

    });


});
</script>
<!--pop up -->
