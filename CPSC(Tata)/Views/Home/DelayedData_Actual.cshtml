<script>
    function printData()
{
        var divToPrint = document.getElementById("sample_editable_1");
        divToPrint.style.borderCollapse = "collapse";


        var th = document.getElementById("sample_editable_1").getElementsByTagName("th");

        for (i = 0; i < th.length; i++) {
            th[i].style.borderColor = "Black";
            th[i].style.borderWidth = "1px";
            th[i].style.borderStyle = "solid";
           // alert(i);
        }
        //th[11].innerHTML = "";
        var td = document.getElementById("sample_editable_1").getElementsByTagName("td");
        for (k = 0; k < td.length; k++) {
            td[k].style.borderColor = "Black";
            td[k].style.borderWidth = "1px";
            td[k].style.borderStyle = "solid";
        }
   newWin= window.open("");
   newWin.document.write(divToPrint.outerHTML);
   newWin.print();
   newWin.close();
   for (l = 0; l < th.length; l++) {
       th[l].style.borderColor = "";
       th[l].style.borderWidth = "";
       th[l].style.borderStyle = "";
   }
   //th[11].innerHTML = "Action";
   var td = document.getElementById("sample_editable_1").getElementsByTagName("td");
   for (m = 0; m < td.length; m++) {
       td[m].style.borderColor = "";
       td[m].style.borderWidth = "";
       td[m].style.borderStyle = "";
   }
}

  
$('#Print').on('click',function(){
printData();
})
$('#ExcelExport').on('click', function () {
    var proc = '@_sql2';
    var flag = '@sheet';
    var Uid = '@Session["Uid"].ToString()';
    var filename = 'report_Delayed' + flag + '_' + Uid + '.xlsx';

    var url_at = '@Url.Action("DTToExcel", "Home")';
    var url_com_at = url_at + '?Proc=' + proc + '&flag=' + flag + '&filename=' + filename;
    //alert(url_com_at);
    var jsonComp_at = $.getJSON(url_com_at, function (result) {

        if (result == true) {

            var uri_file = '@Url.Action("Download", "Home")';
            var uri_file_at = uri_file + '?file=' + filename;
            window.location.href = uri_file_at;
        }
        else {


        }

    });

    return (true);


})
</script>




