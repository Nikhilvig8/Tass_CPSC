                var url_hy = '@Url.Action("TempHyListData", "DropDown")';
                //month, string year, string dealer_code, string division_id, string lob_id,string KPI,string DSE_id,string DSE_name,string Selection
                var url_com_hy = url_hy + "?month=" + month_hy + "&year=" + year_hy + "&dealer_code=" + dealer_hy + "&division_id=" + division_hy + "&lob_id=" + lob_hy + "&KPI=" + kpi_hy + "&Serial_No=" + hy_id_hy + "&Desc=" + hy_name_hy + "&Selection=YES";

                var jsonComp_dse = $.getJSON(url_com_hy, function (result) {
                    //alert(result);
                });

                ///alert($(this).find('option:selected').text());
                YesSelectCount++;
            }
        });
        //$("#ddlid option:selected").text();
        var value_hy = Math.round((YesSelectCount / AllSelectCount)*100);
        //var value_hy = Math.round((YesSelectCount));
        $('#'+input_id_hy).val(value_hy);


        $('#hygienelist').modal('hide');
    }

