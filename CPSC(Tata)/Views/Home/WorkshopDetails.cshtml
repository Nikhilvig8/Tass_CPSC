            //console.log('div' + index + ':' + $(this).attr('id'));
            //alert($(this).val);
            AllSelectCount++;
            if ($(this).find('option:selected').text()=='Yes')
            {

                var hy_details = $(this).find('option:selected').val();
                var hy_details_split = hy_details.split("<<>>");
                var hy_id_hy = hy_details_split[0];
                var hy_name_hy = hy_details_split[1];
