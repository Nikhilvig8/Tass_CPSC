
@{
    ViewBag.Title = "Unlock_Actal_Req";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string monthDesc = Request.QueryString["monthdesc"];//string.Empty;
    string month_id = Request.QueryString["month"];//string.Empty;
    string dealer_id = Request.QueryString["dealer"];//string.Empty;
    string dealer_name = Request.QueryString["dealer_name"];//string.Empty;
    string flag = Request.QueryString["Flag"];
    string Un_id = Request.QueryString["Uid"];
    string LOB = Request.QueryString["LOB"];
    string Div = Request.QueryString["o"];
    string fromwhom = Request.QueryString["fromwhom"];
    string app_disapp_flag = Request.QueryString["app_disapp_flag"];
    string Notification_id = Request.QueryString["Notification_id"];
    string remarks_value = Request.QueryString["remarks_out"];
    string msg = Request.QueryString["msg"];
    string emp_name = Request.QueryString["emp_name"];
}
<script type="text/javascript" nonce="@CspNonce.Current">
    $(document).ready(function ()//When the dom is ready
    {
        //alert('Hi');
        $("#SH").text('@emp_name');

        $("#msg").text('@msg');
        $("#remark").text('@remarks_value');

        //--Submit data--//

        $('#update').click(function () {
            //alert('Hi');

            var FromWhom = '@fromwhom';
            var Dealer_code = '@dealer_id';
            var remark = $("#remark").val();
            var Notifi_id = '@Notification_id';
            var month = '@month_id'
            var un_id = '@Un_id';
            var op = $("input[name='app']:checked").val();
            var flag = '';
            var msg = '';
            //alert(op);
            if (/^[a-zA-Z0-9- ]*$/.test(remark) == false) {
                $("#remark").css("border-color", "red");
                $("#remark").focus();
                $("#msg_2").html("<span style='color:green;'>Special characters are not allowed.</span>");
                var data1 = "<span style='color:green;'>Special characters are not allowed.</span>";
                $('#msg_click').click();
                setTimeout(function () { $('#user_msg').modal('hide'); }, 5000);

                return (false);
            }
            else {
                $("#remark").css("border-color", "gray");
            }

            if (op == '') {
                $("#app").css("border-color", "red");
                $("#app").focus();
                return (false);
            } else
            {
                if (op == 'Approve')
                {
                    flag = 1;
                    msg = 'Approved';
                }
                else
                {
                    flag = 0;
                    msg = op;
                }

            }

                var url_at = '@Url.Action("Update_Unlock_Actual_Notifi", "Home")';

            var url_com_at = url_at + "?fromwhom=" + FromWhom + "&Dealer_code=" + Dealer_code + "&remark=" + remark + "&month=" + month + "&Noti_id=" + Notifi_id + "&flag=" + flag+"&Unid="+un_id;
                //alert(url_com_at);
                var jsonComp_at = $.getJSON(url_com_at, function (result) {
                    if (result == true) {
                        $("#msg_2").html("<span style='color:green;'>Request has been "+msg+".</span>");
                        var data1 = "<span style='color:green;'>Request has been " + msg + ".</span>";





                        $('#msg_click').click();
                        setTimeout(function () { $('#user_msg').modal('hide'); }, 5000);
                        //$('#msg').hide().html(data1).fadeIn('slow').delay(5000).hide(1);

                        window.location = '@Url.Action("Index","Home")'

                    }
                    else {
                        $("#msg_2").html("<span style='color:red;'>Something went wrong.</span>");
                        var data1 = "<span style='color:red;'>Something went wrong.</span>";
                        $('#msg_click').click();
                        setTimeout(function () { $('#user_msg').modal('hide'); }, 5000);
                        //$('#msg').hide().html(data1).fadeIn('slow').delay(5000).hide(1);
                    }

                });

                return (true);




        });


    });
</script>

