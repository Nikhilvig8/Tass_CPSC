@using System.Data;
@using System.Data.SqlClient;
@using System.Globalization;
@using System.Web;
@using DataUtilityLayer;
@using System.Configuration;
@{
    string typeTSM = Session["Type"].ToString();
    string type = string.Empty;
    string OpMode = string.Empty;
    if (typeTSM == "AM" || typeTSM == "TSM" || typeTSM == "RM" || typeTSM == "SPM")
    {
        OpMode = "1";

    }
    else
    {
        OpMode = "2";
    }

    SqlCommand cmdObj1 = new SqlCommand();
    string CS11 = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;

    DataTable dtfdeal;
    string _sqldeal = string.Empty;
    _sqldeal = @"procGetDealer";
    using (SqlConnection cn1 = new SqlConnection(CS11))
    {
        DataTable dt1 = new DataTable();
        //var cmd = new SqlCommand(_sql, cn);
        var daCampus1 = new SqlDataAdapter(_sqldeal, cn1);
        daCampus1.SelectCommand.CommandType = CommandType.StoredProcedure;
        daCampus1.SelectCommand.Parameters.AddWithValue("@OpMOde", OpMode);
        if (typeTSM == "AM" || typeTSM == "ASM" || typeTSM == "SLM" || typeTSM == "SSM")
        {
            daCampus1.SelectCommand.Parameters.AddWithValue("@TSM_CSM_Code", "%");
            daCampus1.SelectCommand.Parameters.AddWithValue("@AM_ASM_Code", Session["Uid"].ToString());

        }
        else
        {
            daCampus1.SelectCommand.Parameters.AddWithValue("@TSM_CSM_Code", Session["Uid"].ToString());
            daCampus1.SelectCommand.Parameters.AddWithValue("@AM_ASM_Code", "%");
        }

        daCampus1.Fill(dt1);
        dtfdeal = dt1;
    }

}


<script src="~/Scripts/jquery3_1.js"></script>
<script type="text/javascript">
    $(document).ready(function () {

        if ('@Session["sflag"].ToString()' == '1')
        {
            $("#success_msg").trigger('click');
            setTimeout(function () {
                $('#success_msg_popup').modal('hide')
            }, 5000);
        }

        $("#clickButton").click(function () {

           // alert('Hi');
            var tod = $("#TOD").val();
            var Date = $("#Date").val();
            var venue = $("#Venue").val();
            var dealer_code = $("#Dealer_Code").val();
            var Tata_Team = $("#Tata_Team").val();
            var Dealer_Team = $("#Dealer_Team").val();

            
            if (tod == '') {

                $("#TOD").css("border-color", "red");
                $("#TOD").focus();
                return (false);
            } else { $("#TOD").css("border-color", "gray"); }

            if (Date == '') {
                $("#Date").css("border-color", "red");
                $("#Date").focus();
                return (false);
            } else { $("#Date").css("border-color", "gray"); }

            if (venue == '') {
                $("#Venue").css("border-color", "red");
                $("#Venue").focus();
                return (false);
            } else { $("#Venue").css("border-color", "gray"); }

            if (dealer_code == '') {
                $("#Dealer_Code").css("border-color", "red");
                $("#Dealer_Code").focus();
                return (false);
            } else { $("#Dealer_Code").css("border-color", "gray"); }


            if (Tata_Team == '') {
                $("#Tata_Team").css("border-color", "red");
                $("#Tata_Team").focus();
                return (false);
            } else { $("#Tata_Team").css("border-color", "gray"); }


            if (Dealer_Team == '') {
                $("#Dealer_Team").css("border-color", "red");
                $("#Dealer_Team").focus();
                return (false);
            } else { $("#Dealer_Team").css("border-color", "gray"); }


            var retflag = true;
            $('.form-control').each(function (index, value) {

               
                var input_val = $(this).val();
                console.log(input_val);
                if (input_val=='') {
                    $(this).css("border", "2px solid red");
                    retflag = false;
                   
                }
                
                else {
                    $(this).css("border", "1px solid gray");
                   
                   
                }
            });

            return retflag;

         


        });

        $("#CancelButton").click(function () {

            location.href='@Url.Action("Insert_MoM","MoM")';
        });

        $('#Date').change(function (e) {

            $("#Date").css("border-color", "#c2cad8");
           
        });

        $('#Dealer_Code').change(function (e) {
            // Your event handler
            var user1 = '@Session["Uid"].ToString()';//Get the value in the username textbox
            var dealer = $("#Dealer_Code").val();
            var Date = $("#Date").val();

            if (Date == '') {
                $("#Date").css("border-color", "red");
                $("#Date").focus();
                $("#Dealer_Code").val('');
                return (false);
            } 

            var url = '@Url.Action("GetPrevData", "MoM")';

            var url_com = url + "?user=" + user1 + "&date=" + Date + "&dealer=" + dealer;
            //alert(url_com);

            var jsonComp = $.getJSON(url_com, function (result) {
               
             
                if(result==true)
                {

                    //alert(result);
                   
                    document.getElementById("para").innerHTML = 'Date is already exists for selected Date & Dealer.Please go to modification screen for further changes.'
                    $("#Dealer_Code").val('');
                    $("#Date").val('');
                    $("#Date").css("border-color", "#c2cad8");
                    $("#success_msg").trigger('click');
                    setTimeout(function () {
                        $('#success_msg_popup').modal('hide')
                    }, 5000);
                }
            });
        });


    });
</script>

