
@{
    Layout = null;
}

@using System.Data;
@using System.Data.SqlClient;
@using System.Globalization;
@using System.Web;
@using DataUtilityLayer;
@using System.Configuration;
@{

    SqlCommand cmdObj1 = new SqlCommand();
    string CS11 = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;

    DataTable dtfdeal;
    string _sqldeal = string.Empty;
    _sqldeal = @"procGetDashboard";
    using (SqlConnection cn1 = new SqlConnection(CS11))
    {
        DataTable dt1 = new DataTable();
        //var cmd = new SqlCommand(_sql, cn);
        var daCampus1 = new SqlDataAdapter(_sqldeal, cn1);
        daCampus1.SelectCommand.CommandType = CommandType.StoredProcedure;
        daCampus1.SelectCommand.Parameters.AddWithValue("@uid", Session["Uid"].ToString());
        daCampus1.Fill(dt1);
        dtfdeal = dt1;
    }

}


<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>Feedback Entry | TATA Motors</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv='X-Frame-Options' content='allow' />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="Preview page of Metronic Admin Theme #1 for " name="description" />
    <meta content="" name="author" />

    <!-- BEGIN GLOBAL MANDATORY STYLES -->

    <link href="../assets/global/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="../assets/global/css/components.min.css" rel="stylesheet" id="style_components" type="text/css" />
    <link rel="shortcut icon" href="favicon.ico" />
    <script type="text/javascript" nonce="@CspNonce.Current">
   function preventBack(){window.history.forward();}
    setTimeout("preventBack()", 0);
    window.onunload = function () { null };
    history.pushState(null, null, document.URL);
    window.addEventListener('popstate', function () {
        history.pushState(null, null, document.URL);
    });

    </script>
    <style type="text/css">
        td, th {
            padding: 10px;
        }
     table.table-bordered > thead > tr > th{
    border:1.5px solid #3598dc;
   
}
table.table-bordered > tbody > tr > td{
    border:1.5px solid #3598dc;
  
}
        table.table-bordered {
            border: 1.5px solid #3598dc;
            
        }
      
    </style>

    <script src="~/Scripts/jquery3_1.js"></script>
    <script type="text/javascript" nonce="@CspNonce.Current">
        $(document).ready(function () {

            var rcount = '@dtfdeal.Rows.Count';
            $("#row_count").val(rcount);

            

        if ('@Session["sflag"].ToString()' == '1')
        {
            $("#success_msg").trigger('click');
            setTimeout(function () {
                $('#success_msg_popup').modal('hide')
            }, 5000);
        }

        $("#clickButton").click(function () {

           // alert('Hi');
            

            var retflag = true;
            $('.form-control').each(function (index, value) {


                var input_val = $(this).val();
                console.log(input_val);
                if (input_val=='') {
                    $(this).css("border", "2px solid red");
                    retflag = false;

                }

                else {
                    $(this).css("border", "1px solid gray");


                }
            });

            return retflag;

        });

        $("#CancelButton").click(function () {

            location.href='@Url.Action("Insert_Feedback","Feedback")';
        });

           
    


    });
    </script>

</head>

@{ Session["sflag"] = 0; }

<body>
@using (Html.BeginForm("Insert_Feedback", "Feedback", FormMethod.Post))
{
    <div class="container-fluid">
