            @{ 
                string type = Session["Type"].ToString();

                DataTable dtf;
                string _sql = string.Empty;

                using (var cn = new SqlConnection(@"Data Source=.;Initial Catalog=Tata;Integrated Security=False;User ID=sa;Password=sa@123"))
                {

                    if (type == "AM")
                    {
                        _sql = @" select (select username from tblUsers where [Uid]=Target_Userid)as Emp_Name,Target_Userid as Uid,Unique_Id from tblMasterTransaction where Approved_Target='0' and Target_Userid is not null and (select [Type] from tblUsers where [Uid]=Target_Userid) in ('AM','TSM')";
                    }
                    else if (type == "ASM")
                    { _sql = @" select (select username from tblUsers where [Uid]=Target_Userid)as Emp_Name,Target_Userid as Uid,Unique_Id from tblMasterTransaction where Approved_Target='0' and Target_Userid is not null and (select [Type] from tblUsers where [Uid]=Target_Userid) in ('ASM','CSM')"; }
                    else if (type == "TSM")
                    { _sql = @" select (select username from tblUsers where [Uid]=Target_Userid)as Emp_Name,Target_Userid as Uid,Unique_Id from tblMasterTransaction where Approved_Target='0' and Target_Userid is not null and (select [Type] from tblUsers where [Uid]=Target_Userid) in ('TSM')"; }
                    else if (type == "CSM")
                    { _sql = @" select (select username from tblUsers where [Uid]=Target_Userid)as Emp_Name,Target_Userid as Uid,Unique_Id from tblMasterTransaction where Approved_Target='0' and Target_Userid is not null and (select [Type] from tblUsers where [Uid]=Target_Userid) in ('CSM')"; }
                    else { _sql = @" select (select username from tblUsers where [Uid]=Target_Userid)as Emp_Name,Target_Userid as Uid,Unique_Id from tblMasterTransaction where Approved_Target='0' and Target_Userid is not null"; }
                    var cmd = new SqlCommand(_sql, cn);
                    cn.Open();
                    var daCampus = new SqlDataAdapter();
                    DataTable dt = new DataTable();
                    daCampus.SelectCommand = cmd;
                    daCampus.Fill(dt);
                    dtf = dt;

                }

            }

