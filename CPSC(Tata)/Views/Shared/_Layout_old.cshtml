    @using System.Data;
    @using System.Data.SqlClient;
    @using System.Globalization;
    @using System.Web;
    <!-- Pending Inputs -->
    @{
        string typePI = Session["Type"].ToString();

        DataTable dtfPI;
        string _sqlPI = string.Empty;

        using (var cnPI = new SqlConnection(@"Data Source=.;Initial Catalog=Tata;Integrated Security=False;User ID=sa;Password=sa@123"))
        {
            _sqlPI = @" select Unique_Id,KPI_Name as KPI,Target_Value,Actual_Value,Last_M_T,Last_M_A from tblTransaction where (Actual_Value='' or Target_value = '') ";
            var cmdPI = new SqlCommand(_sqlPI, cnPI);
            cnPI.Open();
            var daCampusPI = new SqlDataAdapter();
            DataTable dtPI = new DataTable();
            daCampusPI.SelectCommand = cmdPI;
            daCampusPI.Fill(dtPI);
            dtfPI = dtPI;
        }
    }
    <!-- Data OK -->
    @{
        string typeDO = Session["Type"].ToString();

        DataTable dtfDO;
        string _sqlDO = string.Empty;

        using (var cnDO = new SqlConnection(@"Data Source=.;Initial Catalog=Tata;Integrated Security=False;User ID=sa;Password=sa@123"))
        {
            _sqlDO = @" select Unique_Id,KPI_Name as KPI,Target_Value,Actual_Value,Last_M_T,Last_M_A from tblTransaction where Approved = '1' ";
            var cmdDO = new SqlCommand(_sqlDO, cnDO);
            cnDO.Open();
            var daCampusDO = new SqlDataAdapter();
            DataTable dtDO = new DataTable();
            daCampusDO.SelectCommand = cmdDO;
            daCampusDO.Fill(dtDO);
            dtfDO = dtDO;
        }
    }
    <!-- Data Suspect -->
    @{
        string typeDS = Session["Type"].ToString();

        DataTable dtfDS;
        string _sqlDS = string.Empty;

        using (var cnDS = new SqlConnection(@"Data Source=.;Initial Catalog=Tata;Integrated Security=False;User ID=sa;Password=sa@123"))
        {
            _sqlDS = @" select Unique_Id,KPI_Name as KPI,Target_Value,Actual_Value,Last_M_T,Last_M_A from tblTransaction where (Actual_Value < Last_12_M_Min AND Actual_Value > Last_12_M_Max) or (Target_Value < Last_12_M_Min AND Target_Value > Last_12_M_Max) ";
            var cmdDS = new SqlCommand(_sqlDS, cnDS);
            cnDS.Open();
            var daCampusDS = new SqlDataAdapter();
            DataTable dtDS = new DataTable();
            daCampusDS.SelectCommand = cmdDS;
            daCampusDS.Fill(dtDS);
            dtfDS = dtDS;
        }
    }
    <!-- Pending Approval -->
    @{
        string typePA = Session["Type"].ToString();

        DataTable dtfPA;
        string _sqlPA = string.Empty;

        using (var cnPA = new SqlConnection(@"Data Source=.;Initial Catalog=Tata;Integrated Security=False;User ID=sa;Password=sa@123"))
        {
            _sqlPA = @" select Unique_Id,KPI_Name as KPI,Target_Value,Actual_Value,Last_M_T,Last_M_A from tblTransaction where Approved = '0' AND (Target_Value != '' or Actual_Value != '') ";
            var cmdPA = new SqlCommand(_sqlPA, cnPA);
            cnPA.Open();
            var daCampusPA = new SqlDataAdapter();
            DataTable dtPA = new DataTable();
            daCampusPA.SelectCommand = cmdPA;
            daCampusPA.Fill(dtPA);
            dtfPA = dtPA;
        }
    }






    <script type="text/javascript" nonce="@CspNonce.Current">
        var chart = AmCharts.makeChart("chart_1", {
            "type": "serial",
            "pathToImages": "http://cdn.amcharts.com/lib/3/images/",
            "categoryField": "category",
            "rotate": false,
            "colors": [
                "#c7d4f2",
                "#E82323"
            ],
            "startDuration": 1,
            "startEffect": "easeOutSine",
            "handDrawScatter": 4,
            "handDrawThickness": 11,
            "categoryAxis": {
                "gridPosition": "start",
                "position": "left",
                "axisThickness": 1,
                "labelFrequency": 1,
                "showFirstLabel": true,
                "showLastLabel": true,
                "tickLength": 0
            },
            "trendLines": [],
            "graphs": [{
                /*"balloonText": "[[title]]:[[value]]",*/
                "balloonText": "[[value]]",
                "bulletField": "Not set",
                "fillAlphas": 1,
                "id": "chart_1",
                "title": "Yes",
                "type": "column",
                "valueField": "column-1",
                "visibleInLegend": false
            }/*, {
		"balloonText": "[[title]]:[[value]]",
		"fillAlphas": 1,
		"id": "AmGraph-2",
		"title": "No",
		"type": "column",
		"valueField": "column-2",
		"visibleInLegend": false
	}*/],
            "guides": [],
            "valueAxes": [{
                "id": "ValueAxis-1",
                /*"stackType": "100%",*/
                "axisThickness": 1,
                "gridThickness": 1,
                "labelFrequency": 1,
                "labelsEnabled": true,
                "showFirstLabel": true,
                "showLastLabel": true,
                "tickLength": 0,
                "title": ""
            }],
            "allLabels": [],
            "balloon": {},
            "legend": {
                "useGraphSettings": true
            },
            "titles": [
                {
                    "id": "Title-1",
                    "size": 22,
                    "text": ""
                }
            ],
            "dataProvider": [
                {
                    "category": "Pending Inputs",
                    "column-1": "@dtfPI.Rows.Count"/*,
		    "column-2": "13"*/
                },
                {
                    "category": "Approval Pending",
                    "column-1": "@dtfPA.Rows.Count"/*,
		    "column-2": "13"*/
                },
                {
                    "category": "Data Ok",
                    "column-1": "@dtfDO.Rows.Count"/*,
		    "column-2": "13"*/
                },
                {
                    "category": "Suspected Data",
                    "column-1": "@dtfDS.Rows.Count"/*,
		    "column-2": "13"*/
                }
            ]
        });


        chart.addListener("clickGraphItem", handleClick)

        function handleClick(event) {

            if (event.item.category == 'Pending Inputs') {
                window.location = "../KPI/DataReports";
            }
            else if (event.item.category == 'Approval Pending') {
                window.location = "../KPI/DataReportsPA";
            }
            else if (event.item.category == 'Data Ok') {
                window.location = "../KPI/DataReportsDO";
            }
            else if (event.item.category == 'Suspected Data') {
                window.location = "../KPI/DataReportsDS";
            }

            //alert(event.item.category);
            //console.log(event);
        }
    </script>
</body>

