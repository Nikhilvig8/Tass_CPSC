
@{
    ViewBag.Title = "CreateUser";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="../assets/custom/jquery.min11.js" type="text/javascript"></script>
<script type="text/javascript">
    $(document).ready(function () {

        $('#create_user').click(function () {
            var username = $("input[name=username]").val();
            var email = $("input[name=Email]").val();
            var email_valid = /^([\w-\.]+@@([\w-]+\.)+[\w-]{2,4})?$/;
            var user_type = $("#usertype").val();
            var Contact = $("input[name=Contact]").val();
            var Password = $("input[name=Password]").val();
            var Re_Type = $("input[name=Re-Type]").val();
            var numtest = /^[0-9]+$/;
            //alert(user_type);
            if (username == '') {
                alert("Please Enter Name.");
                return (false);
            }
            else if (email == '') {
                alert("Please Enter Email.");
                return (false);
            }
            else if (!(email_valid.test(email))) {
                alert("Please enter valid email id.");
                return (false);
            }
            else if (user_type == '') {
                alert("Please Choose User Type.");
                return (false);
            }
            else if (Contact == '') {
                alert("Please Enter Contact No.");
                return (false);
            }
            else if (!(numtest.test(Contact))) {
                alert("Only Numeric value allowed.");
                return (false);
            }
            else if (Contact.length < 10) {
                alert("10 Numeric values allowed.");
                return (false);
            }
            else if (Contact.length > 10) {
                alert("10 Numeric values allowed.");
                return (false);
            }
            else if (Password == '') {
                alert("Please Enter Password.");
                return (false);
            }
            else if (Password.length < 6) {
                alert("Password should atleast 6 Character Long.");
                return (false);
            }
            else if (Re_Type == '') {
                alert("Please Re-Enter Password.");
                return (false);
            }
            else if (Password != Re_Type) {
                alert("Password not match.");
                return (false);
            }
            else
            {
                return (true);
            }
        });
    });

</script>
<div class="row">
    <div class="col-md-12">

        <div class="portlet light bordered" id="form_wizard_1">
            <div class="portlet-title">
                <div class="caption">
                    <i class="icon-layers font-blue"></i>
                    <span class="caption-subject font-blue bold uppercase">
                        Create User
                    </span>
                </div>

            </div>
            <div class="portlet-body form">
