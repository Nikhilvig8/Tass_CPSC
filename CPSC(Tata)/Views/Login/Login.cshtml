    <script type="text/javascript" nonce="@CspNonce.Current">
   function preventBack(){window.history.forward();}
    // VAPT "Missing HTTP Security Headers": setTimeout("preventBack()", 0) - a STRING argument -
    // requires the browser to evaluate it as code, which needs 'unsafe-eval' in script-src. Passing
    // the function reference instead does exactly the same thing without needing that CSP
    // exception (confirmed live: console showed this exact call being blocked as an eval violation
    // once 'unsafe-eval' was removed). window.onunload's no-op handler is also gone - it did
    // nothing and only produced a "Permissions policy violation: unload" console warning.
    setTimeout(preventBack, 0);
    history.pushState(null, null, document.URL);
    window.addEventListener('popstate', function () {
        history.pushState(null, null, document.URL);
    });

    </script>

    <script type="text/javascript" nonce="@CspNonce.Current">
        $(document).keypress(function (e) {
            if (e.which == 13) {
                //alert('You pressed enter!');
                $("#Login").click();
            }
        });

    </script>

    @* VAPT "Client-Side AES Encryption Key/IV Exposed in HTML": the password is encrypted with
       RSA-OAEP (Web Crypto) using the server's PUBLIC key; the private key never leaves the server.
       A single-use nonce is encrypted with it to block replay. No plaintext fallback - if the
       browser cannot encrypt, the form is not submitted. See App_Code/LoginPasswordCipher.cs. *@
    <script type="text/javascript" nonce="@CspNonce.Current">
        (function () {
            var pwJwk = { kty: "RSA", n: "@ViewBag.RsaN", e: "@ViewBag.RsaE", alg: "RSA-OAEP", ext: true };
            var pwNonce = "@ViewBag.PwNonce";

            function bytesToB64(buffer) {
                var bin = "";
                var arr = new Uint8Array(buffer);
                for (var i = 0; i < arr.length; i++) bin += String.fromCharCode(arr[i]);
                return window.btoa(bin);
            }

            document.addEventListener("DOMContentLoaded", function () {
                var passInput = document.getElementById("pass");
                var encInput = document.getElementById("passEnc");
                var errorBox = document.getElementById("pwEncError");
                var form = passInput ? passInput.form : null;
                if (!form || !encInput) return;
                var submitting = false;

                function showError(msg) {
                    if (errorBox) { errorBox.textContent = msg; errorBox.style.display = "block"; }
                }

                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    if (submitting) return;
                    if (!passInput.value) { showError("Please enter both username and password."); return; }
                    if (!window.isSecureContext || !window.crypto || !window.crypto.subtle || !window.TextEncoder) {
                        showError("Your browser does not support secure login. Please use an up-to-date browser.");
                        return;
                    }

                    submitting = true;
                    var plainBytes = new TextEncoder().encode(pwNonce + "\n" + passInput.value);

                    window.crypto.subtle.importKey("jwk", pwJwk, { name: "RSA-OAEP", hash: "SHA-1" }, false, ["encrypt"])
                        .then(function (cryptoKey) {
                            return window.crypto.subtle.encrypt({ name: "RSA-OAEP" }, cryptoKey, plainBytes);
                        })
                        .then(function (cipherBuffer) {
                            encInput.value = bytesToB64(cipherBuffer);
                            passInput.value = "";
                            HTMLFormElement.prototype.submit.call(form);
                        })
                        .catch(function () {
                            submitting = false;
                            showError("Could not securely submit your password. Please reload the page and try again.");
                        });
                });
            });
        })();
    </script>
