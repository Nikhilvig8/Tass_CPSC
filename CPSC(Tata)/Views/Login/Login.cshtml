    <div class="content login-content">
        <div class="logo" style="margin-left: -15px; margin-right: -15px; padding: 6px; background: #fff; color: #3f5caa; font-size: 14px;">
            <center>TASS CPSC System has been Open for May Target and Actual data entry.</center>
        </div>
        @*<div class="row" align="center" style="margin-top:45px;"><img src="~/assets/Updated_Images/Tata_logo.png" class="img-responsive" title="Tata" style="width:30%;" /></div>*@

        <div class="col-md-7 left-side">
            <div class="row" align="left" style="margin-top:75px;"><img src="~/assets/Updated_Images/Tata_logo.png" class="img-responsive" title="Tata" style="width:30%;margin-left:150px;" /></div>

        </div>
        <div class="col-md-5 right-side">

            <div class="col-md-12 right-bottom">
                @*<div class="row" align="center" style="margin-top:45px;"><img src="~/assets/Updated_Images/Tata_logo.png" class="img-responsive" title="Tata" style="width:60%;" /></div>*@
                <div class="row" align="center">

                    <h4 style="color: #3f5caa;padding:25px;">LOGIN</h4>

                    @using (Html.BeginForm("LoginCheck", "Login", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <!-- Honeypot: invisible to real users (off-screen, unreachable by Tab), but a bot
                             filling every field on the form will populate it. LoginController.LoginCheck
                             treats any non-empty value here as bot traffic. -->
                        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true" />
                        <div class="form-group form-group-css">
                            <input class="form-control form-control-solid placeholder-no-fix username" type="text" autocomplete="off" placeholder="Enter Username" name="username" style="background:#3f5caa" />
                        </div>
                        <div class="form-group form-group-css">
                            <input class="form-control form-control-solid placeholder-no-fix pass" id="pass" type="password" autocomplete="off" placeholder="Enter Password" name="password" style="background:#3f5caa" />
                        </div>
                        <div class="form-group form-group-css" style="text-align:center;">
                            <img src="@Url.Action("CaptchaImage", "Login")" alt="captcha" style="border-radius:3px;vertical-align:middle;" onclick="this.src='@Url.Action("CaptchaImage", "Login")?t='+new Date().getTime();" />
                            <a href="#" onclick="this.previousElementSibling.src='@Url.Action("CaptchaImage", "Login")?t='+new Date().getTime();return false;" style="color:#fff;margin-left:8px;font-size:12px;">refresh</a>
                        </div>
                        <div class="form-group form-group-css">
                            <input class="form-control form-control-solid placeholder-no-fix" type="text" autocomplete="off" placeholder="Enter the code shown above" name="captchaAnswer" maxlength="6" style="background:#3f5caa;color:white;" />
                        </div>
                        <div class="form-group form-group-css">

                            @{
                                if (Session["Popup"] != null)
                                {
                                    if (Session["Popup"].ToString() == "0")
                                    {
                                        <p style="color:white;"> Incorrect Username and Password. </p>
                                    }
                                    else if (Session["Popup"].ToString() == "2")
                                    {
                                        <p style="color:white;"> you are not authorized user.Please contact to CPSC support team.</p>
                                    }
                                    else if (Session["Popup"].ToString() == "4")
                                    {
                                        <p style="color:white;"> Too many failed attempts. Please try again in a few minutes.</p>
                                    }
                                    else if (Session["Popup"].ToString() == "5")
                                    {
                                        <p style="color:white;"> The code shown in the image didn't match. Please try again.</p>
                                    }
                                }
                                Session["Popup"] = string.Empty;
                            }
                        </div>

                        <!--<div class="form-group form-group-css" style="text-align:right;">-->
                        @*<a href="@Url.Action("ForgetPassword","Login")" id="forget-password" class="forget-password"  style="color:#fff;">Forgot Password</a>*@
                        <!--&nbsp;
                        </div>-->


                        <div class="form-group form-group-css">
                            <button type="submit" class="btn btn-block green uppercase login-button" id="Login" style="background: #ffffff;border-color: #ffffff;color: #3f5caa;">SIGN IN</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>


    <a id="msg_click" name="msg_click" class="btn btn-link" style="line-height:0;margin-top:-4px; display:none;" href="#user_msg" data-toggle="modal"><i class="fa fa-edit" style="color:orange;"></i></a>
    <div style="width:715px; margin-left:24%; margin-top:10%;" id="user_msg" class="modal fade" tabindex="-1" data-backdrop="user_msg" data-keyboard="false">
