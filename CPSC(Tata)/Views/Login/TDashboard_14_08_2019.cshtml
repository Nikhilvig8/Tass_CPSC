@model InputOutput.Models.Users
@{
    Layout = null;

    string ticket = Session["ticket"].ToString();
    string dashtype = Session["dashtype"].ToString();
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>Tableau Dashboard | TATA Motors</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv='X-Frame-Options' content='allow' />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="Preview page of Metronic Admin Theme #1 for " name="description" />
    <meta content="" name="author" />

    <!-- BEGIN GLOBAL MANDATORY STYLES -->

    <link href="../assets/global/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />

    <link rel="shortcut icon" href="favicon.ico" />
    <script type="text/javascript">
        function preventBack() { window.history.forward(); }
        setTimeout("preventBack()", 0);
        window.onunload = function () { null };
        history.pushState(null, null, document.URL);
        window.addEventListener('popstate', function () {
            history.pushState(null, null, document.URL);
        });

    </script>

</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="navbar navbar-fixed-top col-lg-12 col-md-12 col-xs-12 col-sm-12" style="min-height:42px; border:1px solid #eee; background:#f0f0f0;">
                <div style="margin-top: 0.6%;margin-left: 2%; font-weight: bold; font-family: times new roman; color: red; float:left;">
                    <span><img src="~/assets/logo/tata-logo.png" /></span>
                </div>

                <div style="margin-top: 0.2%;margin-left: 2%; font-weight: bold; font-family: times new roman; color: red; float:right;height:34px; width:34px;">
                    <a href='~/PDF/read.pdf' target='_blank' style="color:#3598dc;"><img src="~/assets/Dealer_Home/TATA_dashboard_qes.png" style="height:24px; width:24px; margin-left:17%; margin-top:17%;" title="To know more about the parameters,please click" /></a>
                </div>



                <div style="margin-top: 0.2%;margin-left: 2%; font-weight: bold; font-family: times new roman; color: red; float:right; height:34px; width:34px;">
                    <a href="@Url.Action("Login", "Login")"><img src="~/assets/Dealer_Home/TATA_dashboard_Logout.png" style="height:24px; width:24px; margin-left:100%; margin-top:17%;" title="Logout" /></a>
                </div>
@{
    if (Session["Type"].ToString() == "DL")
    {

                <div style="margin-top: 0.2%;margin-left: 2%; font-weight: bold; font-family: times new roman; color: red; float:right; height:34px; width:34px;">
                    <a href="@Url.Action("Insert_Feedback","Feedback")"><img src="~/assets/Dealer_Home/TATA_dashboard_FD.png" style="height:24px; width:24px; margin-left:178%; margin-top:17%;" title="Feedback" /></a>
                </div>

                <div style="margin-top: 0.2%;margin-left: 2%; font-weight: bold; font-family: times new roman; color: red; float:right;height:34px; width:34px;">
                    <a href="@Url.Action("Insert_Feedback_Status","Feedback")"><img src="~/assets/Dealer_Home/TATA_dashboard_FDS.png" style="height:24px; width:24px; margin-left:256%; margin-top:17%;" title="Feedback Status" /></a>
                </div>
        } 
    }
                @{
                    if (Session["Type"].ToString() != "DL")
                    {
                        <div style="margin-top: 0.2%;margin-left: 2%; font-weight: bold; font-family: times new roman; color: red; float:right;
					      height:34px; width:34px;">

                            <a href="@Url.Action("Index", "Home")"><img src="~/assets/Dealer_Home/TATA_dashboard_home.png" style="height:24px; width:24px; margin-left:178%; margin-top:17%;" title="DCL" /></a>
                        </div>
                    }
                    else
                    {
                        <div style="margin-top: 0.2%;margin-left: 2%; font-weight: bold; font-family: times new roman; color: red; float:right;
					      height:34px; width:34px;">
                            <a href="@Url.Action("Dealer_Home", "Login")"><img src="~/assets/Dealer_Home/TATA_dashboard_home.png" style="height:24px; width:24px; margin-left:335%; margin-top:17%;" title="Home" /></a>
                        </div>

                    }
                }

            </div>
            <iframe id="targetedPage" src="" style="width:100%; height:668px; margin-top:-3.4%; border:0px;"></iframe>
        </div>
    </div>

    <script src="../assets/global/plugins/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>

</body>

<script type="text/javascript">
    (function () {


        var ticket = '@ticket';
        var dashtype = '@dashtype';
        var newURL = "";
        if ('@Session["Type"].ToString()' == 'DL' && dashtype == 'Con') {

            newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/ConcurrentDashboard/ConcurrentDealerScorecard";
			//newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/ConcurrentDashboardDec17/DailyScorecard";
            document.getElementById('targetedPage').src = newURL;
        }
        if ('@Session["Type"].ToString()' == 'DL' && dashtype == 'June15') {

            newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/Monthlydealerdashboardswith3LOB/ActualTarget";
            document.getElementById('targetedPage').src = newURL;
        }
        if ('@Session["Type"].ToString()' == 'DL' && dashtype == 'July17') {

            newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/DealerScorecard-Aug17-Oct17/Overalldealerscorecard";
            document.getElementById('targetedPage').src = newURL;
        }
        if ('@Session["Type"].ToString()' == 'DL' && dashtype == 'Qtr') {

            //newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/ConcurrentDashboardOct17/DailyScorecard";
            newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/DealerScorecard_0/OverallDealerScorecard";
            //newURL = "";
            document.getElementById('targetedPage').src = newURL;
        }
        if ('@dashtype' == 'User' && '@Session["dash_type_tml"].ToString()' == 'Monthly')
		{

            //newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/DealerScorecardAug-TML/DealerScorecard";
			if('@Session["Type"].ToString()' == 'SuperAdmin')
			{
			//newURL ="https://infoviz.tatamotors.com/trusted/" + ticket + "t/CPSCTMLSite/views/TMLScorecardRevised/ChannelPartnerScorecard";
			newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/TMLScorecardRevised/ChannelPartnerScorecard";
			}
			else
			{
            newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/TML-DealerScorecard/OverallDealerScorecard";
			}
			document.getElementById('targetedPage').src = newURL;
        }
        if ('@dashtype' == 'User' && '@Session["dash_type_tml"].ToString()' == 'Con') {

            //newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/DealerScorecardAug-TML/DealerScorecard";
            newURL = "https://infoviz.tatamotors.com/trusted/" + ticket + "/views/Concurrent-TMLDealerScorecard/OverallDealerScorecard";
            document.getElementById('targetedPage').src = newURL;
        }

    })();
</script>
</html>
