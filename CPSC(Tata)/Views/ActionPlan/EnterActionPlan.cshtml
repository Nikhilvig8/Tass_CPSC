                                <th>Metric Name</th>
                                <th>Max Points</th>
                                <th>Para Score RYG</th>
                                @*<th>Current Status RYG</th>*@
                                <th>Observation</th>
                                <th>Action Plan</th>
                                <th>Responsibility</th>
                                @*<th>Data Status</th>*@
                            </tr>


                            @foreach (var actionPlanModel in Model)
                            {

                                <tr id="ActionPlanDetails" class="ActionPlanDetails">

                                    @*<input type="hidden" id="TransId" class="TransId" value="" />*@
                                    @*<td><label id="RowNo">@actionPlanModel.RowNo</label></td>*@
                                    <td><label id="Parameter">@actionPlanModel.Parameter</label></td>
                                    <td><label id="MetricName">@actionPlanModel.MetricName</label></td>
                                    <td><label id="MaxPoints">@actionPlanModel.MaxPoint</label></td>
                                    <td><label id="ParaScoreRYG">@actionPlanModel.ParaScoreRYG</label></td>
                                    @*<td>
                                            @Html.DropDownList("CurrentStatus", (IEnumerable<SelectListItem>)ViewBag.ActionPlans, new { @id = "CurrentStatus" })
                                        </td>*@
                                    <td>@Html.TextBox("Observation", actionPlanModel.Observation, new { @class = "form-control", @id = "Observation" })  </td>
                                    <td>@Html.TextBox("ActionPlan", actionPlanModel.ActionPlan, new { @class = "form-control", @id = "ActionPlan" })  </td>
                                    <td>@Html.TextBox("Responsibility", actionPlanModel.Responsibility, new { @class = "form-control", @id = "Responsibility" })  </td>
                                    <td>@Html.TextBox("Timeline", actionPlanModel.Timeline, new { @class = "form-control cal", @id = "Timeline" })  </td>


                                </tr>
                            }
                            </>
                        </table>
                    </div>


                </div>

            </div>
            <div id="row" style="margin:0px;">
                <div class="col-md-8">&nbsp;</div>
                <div class="col-md-4">
                    <button class="btn green button-submit" id="Cancel">Cancel</button>&nbsp;&nbsp;&nbsp;&nbsp;
                    <button class="btn green button-submit" id="Update">Save</button>
                    @{
                        string Type = Session["Type"].ToString();

                    }
                    <input type="hidden" id="Type" value="@Type">
                </div>

            </div>
        </div>

        <br />
        @*<div class="form-actions" style="padding:5px;">
