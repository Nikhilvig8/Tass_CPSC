<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js"></script>
<script type="text/javascript" nonce="@CspNonce.Current">
    DealersDetails();

    function DealersDetails() {
        var DealerCode = $("#Dealer").val();
        //alert(DealerCode);
        $.ajax
            ({
                type: "POST",
                url: "/SalesManpowerAudit/SalesManpowerAuditDetails",
                data:
                {
                    DealerCode: DealerCode
                },
                dataType: "json",
                success: function (data) {
                    var item = JSON.parse(data);
                    var htm = '';
                    //alert(item[0].IsActive);

                    htm += '<tr>';
                    htm += '<th>Employee Code</th>';
                   /* htm += '<th>LOB</th>';*/
                    htm += '<th>Designation</th>';
                    htm += '<th>Employee First Name</th>';
                    htm += '<th>Employee Middle Name</th>';
                    htm += '<th>Employee Last Name</th>';
                    htm += '<th>IsActive</th>';
                    htm += '</tr>';
                    for (var i = 0; i < item.length; i++) {
                        htm += '<tr id="TMLDistributorTb" class="TMLDistributorTb">';
                        htm += '<td id="EmployeeLogin">' + item[i].EmployeeLogin + '</td>';
                        /*htm += '<td>' + item[i].LOB + '</td>';*/
                        htm += '<td>' + item[i].PositionType + '</td>';
                        htm += '<td>' + item[i].EmployeeFirstName + '</td>';
                        htm += '<td>' + item[i].EmployeeMiddleName + '</td>';
                        htm += '<td>' + item[i].EmployeeLastName + '</td>';
                        if (item[i].IsActive == "Yes") {
                            htm += '<td> <select id="IsActive"> <option value="Yes" selected>Yes</option> <option value="No">No</option></select></td>';
                        }
                        else {
                            htm += '<td> <select id="IsActive"> <option value="Yes" >Yes</option> <option value="No" selected>No</option></select></td>';
                        }
                        htm += '</tr>';
                    }
                    $('#tblSalesManpowerAudit').html(htm);
                    $('#totalrow').html('<span>' + item[0].TotalRowCount+'</span>');


                }
            });
    }

    $("#Update").click(function () {
        let data = [];
        $('.TMLDistributorTb').each(function () {
            let IsActive = $(this).find('#IsActive').val();
            let EmployeeLogin = $(this).find('#EmployeeLogin').text();
            var DealerCode = $("#Dealer").val();
            data.push
                ({
                    IsActive: IsActive,
                    EmployeeLogin: EmployeeLogin,
                    DealerCode: DealerCode,
                });
        });
        var jsoN = JSON.stringify(data);

        $.ajax
            ({
                type: "Post",
                cache: false,
                url: "/SalesManpowerAudit/SalesManpowerAuditForDisable",
                data: { json: "" + jsoN + "" },
                success: function (drr) {
                    alert(JSON.parse(drr));
                    var url = "/SalesManpowerAudit/SalesManpowerAudit";
                    window.location.href = url;
                },
                Error: function (err) {
                    // alert('unsuccess');
                    Console.log(err);
                }
            });

    });
</script>