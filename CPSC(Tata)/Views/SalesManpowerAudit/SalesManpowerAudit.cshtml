
@{
                /**/

                Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="page-content-wrapper">
    <div class="card mt-2">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between">
                <h4 style="margin-right:2rem" class="caption-subject font-blue bold uppercase">Current Manpower</h4>
                <div style="margin-top:10px; margin-bottom:10px">
                    <span style="margin-right:10px">TASS:</span>@Html.DropDownList("Dealer", new SelectList(ViewBag.Dealer, "DealerCode", "DealerName"), new { @onchange = "DealersDetails(this.value)" })
                </div>
            </div>

            <div class="portlet-body form" style="overflow:auto; max-height:475px;">


                <div class="form-horizontal">
                    <div class="form-wizard" style="width:99%;">
                        <div class="form-body" style="padding:5px;">
                            <div>Total Rows: <label id="totalrow"></label>  </div>
                            <table class="table table-striped table-hover table-bordered" id="tblSalesManpowerAudit">
                                <thead>
                                    <tr>
                                        <th>Employee Code</th>
                                        @*<th>LOB</th>*@
                                        <th>Designation</th>
                                        <th>Employee First Name</th>
                                        <th>Employee Middle Name</th>
                                        <th>Employee Last Name</th>
                                        <th>IsActive</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>


                        </div>


                    </div>
                    <!--col-md-offset-7 -->


                </div>



            </div>

        </div>
    </div>


    <div class="butn-cvr" style=" margin-left: 88%;">
        <button class="btn btn-info" id="Update">Submit</button>
    </div>


</div>


