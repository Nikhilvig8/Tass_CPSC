        <script src="~/Scripts/jquery-3.3.1.js"></script>
        <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js"></script>
        <script type="text/javascript">
            callDealerdetails();
            function callDealerState() {
                var DealerRegion = $("#DealerRegion").val();
                //alert(DealerRegion);
                $.ajax
                    ({
                        type: "POST",
                        url: "/DataFilling/DealerState",
                        data:
                        {
                            DealerRegion: "" + $('#DealerRegion').val()
                        },
                        //alert(data);
                        dataType: "json",
                        success: function (data) {
                            for (var i = 0; i < data.length; i++) {
                                DealerState += '<option value="' + data[i].Value + '" >' + data[i].Text + '</option>';
                            }
                            $("#DealerState").html(DealerState);
                            //callDealerdetails();
                        }
                    });
            }
            function callDealerdetails() {
                var Region = $("#DealerRegion").val();
                var StateId = $("#DealerState").val();
                $.ajax
                    ({
                        type: "POST",
                        url: "/DataFilling/DataFillingDetails",
                        data:
                        {
                            Region: Region,
                            StateId: StateId
                        },
                        dataType: "json",
                        success: function (data)
                        {
                            var d = JSON.parse(data);
                            var IsLocked = "@ViewBag.IsLocked";
                            var htm = '';
                            if (IsLocked == "False")
                            {
                                if (d.length > 0)
                                {
                                    htm += '<tr>';
                                    htm += '<th></th>';
                                    htm += '<th>State TIV(N-1)</th>';
                                    htm += '<th>State TMV(N-1)</th>';
                                    htm += '<th>State MS(N-1)</th>';
                                    htm += '<th>YTD (N-1)TIV</th>';
                                    htm += '<th>YTD (N-1)TMV</th>';
                                    htm += '<th>YTD (N-1)MS</th>';
                                    htm += '</tr>';
                                    for (var i = 0; i < d.length; i++) {
                                        htm += '<tr>';
                                        htm += '<td><input type="text" id="ILCV" disabled class="LOB" value=" '  + d[i].LOB + ' "/></td>';
                                        htm += '<td><input type="text" id="TIVILCV" class="TIVILCV" value=" '+ d[i].TIV + '"/></td>';
                                        htm += '<td><input type="text" id="TMVILCV" class="TMVILCV" value=" '+ d[i].TMV + '"/></td>';
                                        htm += '<td><input type="text" id="MSILCV" class="MSILCV" value=" '+ d[i].MS + '"/></td>';
                                        htm += '<td><input type="text" id="YTDTIVILCV" class="YTDTIVILCV" value=" '+ d[i].YTDTIV + '"/></td>';
                                        htm += '<td><input type="text" id="YTDTMVILCV" class="YTDTMVILCV" value="' + d[i].YTDTMV +' "/></td>';
                                        htm += '<td><input type="text" id="YTDMSILCV" class="YTDMSILCV" value=" '+ d[i].YTDMS + '"/></td>';
                                        htm += '</tr> ';
                                    }
                                   $('#tblSH').html(htm);
                                   $("#Insert").attr('disabled', true);
                                   $("#Cancel").attr('disabled', true);
                                   $(".IsDisabled").attr('disabled', false);
                                }
                                else
                                {
                                    $('table').find('tr').not(':first').each(function () {
                                        $(this).find(".TIVILCV").val('');
                                        $(this).find(".TMVILCV").val('');
                                        $(this).find(".MSILCV").val('');
                                        $(this).find(".YTDTIVILCV").val('');
                                        $(this).find(".YTDTMVILCV").val('');
                                        $(this).find(".YTDMSILCV").val('');
                                    });
                                    $(".IsDisabled").attr('disabled', false);
                                    $("#Insert").attr('disabled', false);
                                    $("#Cancel").attr('disabled', false);
                                }


                            }
                            else
                            {
                                $(".IsDisabled").attr('disabled', true);
                                $("#Insert").attr('disabled', true);
                                $("#Cancel").attr('disabled', true);
                            }
                        }
                    });
            }
            $("#Insert").click(function () {
                var json = '';
                let data = [];
               {
                    let DealerRegion = $("#DealerRegion :selected").val();
                    let DealerState = $("#DealerState :selected").val();
                    $('table').find('tr').not(':first').each(function () {
                        DealerRegion = DealerRegion;
                        DealerState = DealerState;
                        let LOB = $(this).find(".LOB").val();
                        let TIVILCV = $(this).find(".TIVILCV").val();
                        let TMVILCV = $(this).find(".TMVILCV").val();
                        let MSILCV = $(this).find(".MSILCV").val();
                        let YTDTIVILCV = $(this).find(".YTDTIVILCV").val();
                        let YTDTMVILCV = $(this).find(".YTDTMVILCV").val();
                        let YTDMSILCV = $(this).find(".YTDMSILCV").val();
                        data.push
                        ({
                            Region: DealerRegion,
                            State: DealerState,
                            LOB: LOB,
                            TIV: TIVILCV,
                            TMV: TMVILCV,
                            MS: MSILCV,
                            YTDTIV: YTDTIVILCV,
                            YTDTMV: YTDTMVILCV,
                            YTDMS: YTDMSILCV,
                         });
                     json = JSON.stringify(data);
                    });
                    $.ajax
                        ({
                            type: "Post",
                            cache: false,
                            url: "/DataFilling/DataFillingInsert",
                            data: { json: "" + json + "" },
                            success: function (drr) {
                                alert(JSON.parse(drr));
                                var url = "/DataFilling/DataFilling";
                                window.location.href = url;
                            },
                            Error: function (err) {
                                // alert('unsuccess');
                                Console.log(err);
                            }
                        });
               }

            });
            $("#Cancel").click(function () {
                var url = "/DataFilling/DataFilling";
                window.location.href = url;
            });
        </script>



