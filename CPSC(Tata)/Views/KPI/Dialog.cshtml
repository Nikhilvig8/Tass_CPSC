<script type="text/javascript">
    $(document).ready(function ()//When the dom is ready
    {
        var count = $("#count").val();
        var j = "0";
        $(".Select_Value").change(function () {
            var select_val = $(this).val();
            if (select_val == "YES") { j++; } else { j--;}
            var cal_percnt = (j / count) * 100;
            $("#total_val_view").html(cal_percnt+"%");
            $("#total_val_view").val(cal_percnt + "%");
        });
        //
    });
</script>

            <!-- Pop up start -->

            <!--a class="btn purple btn-outline sbold" data-toggle="modal" href="#static" id="clickButton"></a-->
            <div id="static" class="modal fade" tabindex="-1" data-backdrop="static" data-keyboard="false">
                <div class="modal-dialog" style="border:2px solid #3598dc; width:75%;">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                            <h4 class="modal-title">Service Hygiene Checklist (Yes/No)</h4>
                        </div>
                        @using (Html.BeginForm("Dialog", "KPI", FormMethod.Post))
                        {
                            <div class="modal-body" style="overflow:auto;max-height:400px;">

                                <!-- Pop up body start-->
                                
                                <div class="form-group">
                                    <label class="control-label col-md-1" style="font-weight:bold;">No.</label>
                                    <label class="control-label col-md-8" style="font-weight:bold;">Description</label>
                                    <label class="control-label col-md-3" style="font-weight:bold;">&nbsp;</label>
                                </div>

                                <!-- row 1 start-->
                                <!-- Tooltip start -->
                                <input type="hidden" name="count" id="count" value="@dtfHy.Rows.Count" />
                                @{
                                    if (dtfHy.Rows.Count > 0)
                                    {
                                        for (int i = 0; i < dtfHy.Rows.Count; i++)
                                        {
                                            
                                    <div class="form-group">
                                        <div class="col-md-1">
                                            <label class="control-label" name="no">
                                                @dtfHy.Rows[i]["SerialNo"].ToString()
                                            </label>
                                            <input type="hidden" name="no@(i)" value="@dtfHy.Rows[i]["SerialNo"].ToString()" />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="control-label" name="description">
                                                @dtfHy.Rows[i]["Description"].ToString()
                                            </label>
                                            <input type="hidden" name="des@(i)" value="@dtfHy.Rows[i]["Description"].ToString()" />
                                        </div>
                                        <div class="col-md-3">
                                            <select id="Select_Value" name="Select_Value@(i)" class="form-control Select_Value" style="margin-bottom:2px;">
                                                <option value="NO" @("NO" == @dtfHy.Rows[i]["Selection"].ToString() ? "Selected" : " ")>No</option>
                                                <option value="YES" @("YES" == @dtfHy.Rows[i]["Selection"].ToString() ? "Selected" : " ")>Yes</option>
                                            </select>
                                        </div>
                                    </div>
                                            }
                                        }
                                    }

                                <div class="form-group">
                                    <div class="col-md-1">
                                        <label class="control-label" name="premise">
                                            &nbsp;
                                        </label>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="control-label" name="KPI">
                                           <b>Net Score {Out of 100}</b>
                                        </label>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="control-label" name="premise" id="total_val_view" style="font-weight:bold;">&nbsp;</label>
                                        <input type="hidden" name="total_val" id="total_val" value="" />
                                    </div>
                                </div>
                                <!-- row 1 end-->
                                <!-- Pop up body end-->
                                
                            </div>
                                    <div class="modal-footer">
                                        <input type="submit" value="Submit" name="submitButton" class="btn green button-submit" />
                                    </div>
                                    }
                    </div>
                </div>
            </div>
            <!-- Pop up end -->


                                </div>
                            </div>
                        </div>
