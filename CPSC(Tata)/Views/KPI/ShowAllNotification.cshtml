                                                    {

                                                    }
                                                    <div style="text-align:left; padding-top:50px; color:black; font-size:11px;">@dtf.Rows[i]["Dealer_Name"] , @dtf.Rows[i]["Division_Name"] , @dtf.Rows[i]["LOB"] @*dtf.Rows[i]["MSG"]*@.</div>
                                                </div>
                                            </a>
                                        }
