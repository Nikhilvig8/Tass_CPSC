        <div class="portlet light bordered" id="form_wizard_1" style="max-height: 485px;">
            <div class="portlet-title" style="min-height:30px; margin-bottom:0px;">
                <div class="caption" style="padding:0px 0;">
                    @*<i class="icon-layers font-blue"></i>*@
                    <i class="glyphicon glyphicon-list-alt font-blue"></i>
                    <span class="caption-subject font-blue bold uppercase">
                        All Notification
                    </span>
                </div>



            </div>

            @using (Html.BeginForm("AllNotificationSubmission", "KPI", FormMethod.Post, new { id = "Notification", name = "Notification" }))
            {

