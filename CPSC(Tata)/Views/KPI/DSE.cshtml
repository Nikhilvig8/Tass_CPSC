    <link href="../assets/global/css/custom.css" rel="stylesheet" type="text/css" />
    <title>Hygiene</title>
</head>
<body>
    <div>
        <table class="table table-striped">
            <thead>
                <tr style="Color:blue;"><th> DSE list (Yes/No)</th></tr>
                <tr>
                    <th>No.</th>
                    <th>DES</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (dtfDSE.Rows.Count > 0)
                    {
                        for (int i = 0; i < dtfDSE.Rows.Count; i++)
                        {
                            <tr>
                                <td>@dtfDSE.Rows[i]["DSE_Id"].ToString()</td>
                                <td>@dtfDSE.Rows[i]["DSE_Name"].ToString()</td>
                                <td>
                                    <select id="Select_Value" name="Select_Value" class="form-control">
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</body>
