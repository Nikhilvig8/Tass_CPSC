                                                        <td style="font-size:11px;">@dtf2.Rows[i]["KPI_NAME"].ToString()</td>
                                                        @*<td style="font-size:11px;">@dtf2.Rows[i]["Actual_Value"].ToString()</td>
                                                            <td style="font-size:11px;">@dtf2.Rows[i]["Target_Value"].ToString()</td>*@
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Last_M_T"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Last_M_A"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Target_Value"].ToString()</td>
                                                        <td style="font-size:11px;">@dtf2.Rows[i]["Actual_Value"].ToString()</td>

                                                    </tr>

                                                }
                                            }
