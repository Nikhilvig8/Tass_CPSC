                        <div class="form-body" style="padding:5px;">

                            <div class="tab-pane active" id="tab1">
                                <!--h3 class="block">Provide your account details</h3-->





                                <table id="DOTarget" class="table table-striped table-bordered display" cellspacing="0" width="100%">
                                    @*<table class="table table-bordered table-striped" id="divisionList">*@
                                    <thead>
                                        <tr style="background-color:#ccc;">
                                            <th style="font-size:11px;">TASS</th>
                                            <th style="font-size:11px;">Division</th>
                                            @*<th style="font-size: 11px; display: none">LOB</th>*@
                                            <th style="font-size:11px;">Parameter</th>
                                            <th style="font-size:11px;">Last Month Target</th>
                                            <th style="font-size:11px;">Last Month Actual</th>
                                            <th style="font-size:11px;">Target(@DateTime.Parse(Session["Target_Date"].ToString()).ToString("MMM")'@DateTime.Parse(Session["Target_Date"].ToString()).ToString("yy"))</th>
                                            <th style="font-size:11px;">Actual(@DateTime.Parse(Session["Target_Date"].ToString()).ToString("MMM")'@DateTime.Parse(Session["Target_Date"].ToString()).ToString("yy"))</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @{
