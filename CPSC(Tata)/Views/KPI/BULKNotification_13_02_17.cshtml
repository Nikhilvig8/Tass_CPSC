<script type="text/javascript">
    $(document).ready(function ()//When the dom is ready
    {
        //$("#input").popover({ trigger: 'focus' });

        //put Dealer city name in city span
        var Dealer_name1 = $("#Dealer_main :selected").text();
        var dealer_split = Dealer_name1.split("-");
        var dealer_city = dealer_split[1];
        //alert(dealer_city);
        $("#dealer_city").html(dealer_city);


        $("#Dealer_main").bind('change', function () {
            $('#tableHeader').html("");
            //alert('hello');
            var user1 = '@fromwhom';//Get the value in the username textbox
            var dealer = $("#Dealer_main").val();
            var month = $("#Month_main").val();

            //var year = '2016';
            var flag_chk = '@flag';
            if (flag_chk == 'Actual' || flag_chk == 'BulkActual') { var url = '@Url.Action("GetBulkData", "DropDown")'; }
            else { var url = '@Url.Action("GetBulkDataTarget", "DropDown")'; }


            var url_com = url + "?user=" + user1 + "&month=" + month + "&dealer=" + dealer;
            //alert(url_com);

            var jsonComp = $.getJSON(url_com, function (result) {
                //alert(result);

                var split_res = result.split("^");

                var data = split_res[0];
                var column = split_res[1];
                //alert(column);

                var html = "";
                var columnCount = "";
                $.each(eval(column.replace(/[\r\n]/, "")), function (i, item) {
                    if (item.Column_Name == 'Dealer_Code' || item.Column_Name == 'LOB_ID' || item.Column_Name == 'Division_Id' || item.Column_Name == 'Order_Level' || item.Column_Name == 'Dealer_Level' || item.Column_Name == 'Division_Level' || item.Column_Name == 'LOB_Level') { }
                    else
                    {
                        if (item.Column_Name == "Division_Name")
                        { html += ('<td id="DivisionRow">Division Name <input type="hidden" name="column_count" value="' + item.Count + '" /></td>'); }
                        else if (item.Column_Name == "LOB")
                        { html += ('<td id="DivisionRow">Product Line</td>'); }
                        else
                        {
                            var kpi_col = item.Column_Name;
                            if (kpi_col.includes("<<>>")) {
                                var kpi = kpi_col.split("<<>>");
                                var kpi_name = kpi[0];
                                var kpi_id = kpi[1];
                                html += ('<td id="DivisionRow">' + kpi_name + '  </td>');
                            }
                            else {
                                html += ('<td id="DivisionRow">' + item.Column_Name + '</td>');
                            }
                        }
                    }
                    columnCount = item.Count;
                });
                $('#tableHeader').html(html);
                //alert(columnCount);
                //Data

                var htmlData = "";
                var s = "0";
                $.each(eval(data.replace(/[\r\n]/, "")), function (ii, itemi) {

                    htmlData += "<tr>";

                    var t = "0";
                    for (p in itemi) {

                        if (t == "0" || t == "1" || t == "2" || t == "4" || t == "6" || t == "7" || t == "8") {
                            htmlData += "<input type='hidden' id='" + p + "" + ii + "" + t + "' name='" + p + "" + ii + "" + t + "' value='" + itemi[p] + "' />";
                        }
                        else if (t == "3" || t == "5") {
                            htmlData += "<td id='row' style='width:10%;'>" + itemi[p] + "</td>";
                            htmlData += "<input type='hidden' id='" + p + "" + ii + "" + t + "' name='" + p + "" + ii + "" + t + "' value='" + itemi[p] + "' />";
                        }
                        else {
                            //alert(itemi[p]);
                            if (itemi[p] == null) { htmlData += "<td id='row' style='width:10%;'>&nbsp;</td>"; }
                            else
                            {

                                var kpi_data_to_split = itemi[p];
                                var split_kpi_data = kpi_data_to_split.split("<<>>");
                                var kpi_id_split = split_kpi_data[0];
                                var kpi_val_split = split_kpi_data[1];
                                var kpi_tooltip_split = split_kpi_data[2];
                                var kpi_input_type = split_kpi_data[3];
                                var kpi_input_pattern = split_kpi_data[4];
                                var kpi_input_keypress = split_kpi_data[5];
                                var kpi_input_popup = split_kpi_data[6];

                                if (kpi_val_split == "NULL") { kpi_val_split = ""; }

                                htmlData += '<td id="row" style="width:10%;"><input type="hidden" name="kpi_id' + ii + '' + t + '" id="kpi_id' + ii + '' + t + '" value="' + kpi_id_split + '" /><input id="input' + ii + "" + t + '" class="input" type="' + kpi_input_type + '"  onkeypress="' + kpi_input_keypress + '" readonly  name="target' + ii + '' + t + '"  value="' + kpi_val_split + '" data-toggle="popover" data-trigger="focus" data-placement="bottom" data-html="true" data-content="' + kpi_tooltip_split + '"  /> </td>';
                                //htmlData += "<td id='row' style='width:10%;'><input type='hidden' name='kpi_id" + ii + "" + t + "' id='kpi_id" + ii + "" + t + "' value='" + kpi_id_split + "' /><input id='input' type='number' name='target" + ii + "" + t + "'  value='" + kpi_val_split + "' data-toggle='popover' data-trigger='focus' data-placement='bottom' data-html='true' data-content='" + kpi_tooltip_split + "'  /> </td>";
                            }

                        }

                        t++;
                    }
                    s++;
                    htmlData += "</tr>";

                });
                $("#row_count").val(s);
                $('#tableData').html(htmlData);

            });
            return false;
        }).trigger('change');



    });
</script>
@using System.Data;
@using System.Data.SqlClient;
@using System.Globalization;
@using System.Web;
@using DataUtilityLayer;
@using System.Configuration;
@{
    SqlCommand cmdObj = new SqlCommand();
    string uid2 = Session["Uid"].ToString();
    string CS1 = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;

    string typeTSM = Session["Type"].ToString();
    string type = string.Empty;
    string OpMode = string.Empty;
    if (typeTSM == "AM" || typeTSM == "TSM" || typeTSM == "RM")
    {
        OpMode = "1";

    }
    else
    {
        OpMode = "2";
    }

    DataTable dtf21;
    string _sql2 = string.Empty;
    _sql2 = @"getBulkEntryActual";
    using (SqlConnection cn = new SqlConnection(CS1))
    {
        DataTable dt = new DataTable();
        //var cmd = new SqlCommand(_sql, cn);
        var daCampus = new SqlDataAdapter(_sql2, cn);
        daCampus.SelectCommand.CommandType = CommandType.StoredProcedure;
        daCampus.SelectCommand.Parameters.AddWithValue("@User_Id", Session["Uid"].ToString());

        daCampus.Fill(dt);
        dtf21 = dt;
    }

}

@{
    SqlCommand cmdObj1 = new SqlCommand();
    string CS11 = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;

    DataTable dtfdeal;
    string _sqldeal = string.Empty;
    _sqldeal = @"procGetDealer";
    using (SqlConnection cn1 = new SqlConnection(CS11))
    {
        DataTable dt1 = new DataTable();
        //var cmd = new SqlCommand(_sql, cn);
        var daCampus1 = new SqlDataAdapter(_sqldeal, cn1);
        daCampus1.SelectCommand.CommandType = CommandType.StoredProcedure;
        daCampus1.SelectCommand.Parameters.AddWithValue("@OpMOde", OpMode);
        if (typeTSM == "AM" || typeTSM == "ASM")
        {
            daCampus1.SelectCommand.Parameters.AddWithValue("@TSM_CSM_Code", "%");
            daCampus1.SelectCommand.Parameters.AddWithValue("@AM_ASM_Code", Session["Uid"].ToString());

        }
        else
        {
            daCampus1.SelectCommand.Parameters.AddWithValue("@TSM_CSM_Code", Session["Uid"].ToString());
            daCampus1.SelectCommand.Parameters.AddWithValue("@AM_ASM_Code", "%");
        }

        daCampus1.Fill(dt1);
        dtfdeal = dt1;
    }

}

