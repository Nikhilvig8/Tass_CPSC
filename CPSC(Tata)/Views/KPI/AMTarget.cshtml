                                            </label>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="control-label" name="premise" id="total_val_view" style="font-weight:bold;">&nbsp;</label>
                                            <input type="hidden" name="total_val" id="total_val" value="" />
                                        </div>
                                    </div>
                                    <!-- row 1 end-->
                                    <!-- Pop up body end-->

                                </div>
                                <div class="modal-footer">
                                    <input type="submit" value="Submit" name="submitButton" class="btn green button-submit" onclick="onDsmlistclose()" />
                                </div>

                            </div>
                        </div>
                    </div>
                    <!-- Pop up end -->

                    <!-- Sales Activity Pop up start -->
                    <!--a class="btn purple btn-outline sbold" data-toggle="modal" href="#static" id="clickButton"></a-->
                    <div id="salesactivitylist" class="modal fade" tabindex="-1" data-backdrop="static" data-keyboard="false">
                        <div class="modal-dialog" style="border:2px solid #3598dc; width:75%;">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                                    <h4 class="modal-title">Sales Activity List (Yes/No)</h4>
                                </div>
                                <div class="modal-body" style="overflow:auto;max-height:400px;">

                                    <!-- Pop up body start-->

                                    <div class="form-group">
                                        <label class="control-label col-md-3" style="font-weight:bold;">Name</label>
                                        <label class="control-label col-md-6" style="font-weight:bold;">Event</label>
                                        <label class="control-label col-md-3" style="font-weight:bold;">&nbsp;</label>
                                    </div>

                                    <!-- row 1 start-->
                                    <!-- Tooltip start -->
                                    <input type="hidden" name="count" id="count" value="@dtfsal.Rows.Count" />
                                    @{
                                        if (dtfsal.Rows.Count > 0)
                                        {
                                            for (int l = 0; l < dtfsal.Rows.Count; l++)
                                            {

                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label" name="no">
                                                            @dtfsal.Rows[l]["DSE_Name"].ToString()
                                                        </label>
                                                        <input type="hidden" name="no@(l)" value="@dtfsal.Rows[l]["DSE_Name"].ToString()" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="control-label" name="description">
                                                            @dtfsal.Rows[l]["Event"].ToString()
                                                        </label>
                                                        <input type="hidden" name="des@(l)" value="@dtfsal.Rows[l]["Event"].ToString()" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        @{
                                                            if (string.IsNullOrEmpty(@dtfsal.Rows[l]["Selection"].ToString()))
                                                            {
                                                                <input type="hidden" name="Select_Value@(l)" value="NULL" />
                                                            }
                                                            else
                                                            {
                                                                <select id="Select_Value" name="Select_Value@(l)" class="form-control Select_Value sallist" style="margin-bottom:2px;">
                                                                    <option value="NO" @("NO" == @dtfsal.Rows[l]["Selection"].ToString() ? "Selected" : " ")>No</option>
                                                                    <option value="YES" @("YES" == @dtfsal.Rows[l]["Selection"].ToString() ? "Selected" : " ")>Yes</option>
                                                                </select>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                                                }
                                                            }
                                    }

                                    <div class="form-group">
                                        <div class="col-md-1">
                                            <label class="control-label" name="premise">
                                                &nbsp;
                                            </label>
                                        </div>
                                        <div class="col-md-8">
                                            <label class="control-label" name="KPI">
                                                &nbsp;
                                            </label>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="control-label" name="premise" id="total_val_view" style="font-weight:bold;">&nbsp;</label>
                                            <input type="hidden" name="total_val" id="total_val" value="" />
                                        </div>
                                    </div>
                                    <!-- row 1 end-->
                                    <!-- Pop up body end-->

                                </div>
                                <div class="modal-footer">
                                    <input type="submit" value="Submit" name="submitButton" class="btn green button-submit" onclick="onSaleslistclose()" />
                                </div>

                            </div>
                        </div>
                    </div>
                    <!-- Pop up end -->
                </div>



            </div>
        </div>
    </div>
</div>

<script>
    function onhygienelistclose() {
        var AllSelectCount = 0; //$(".Select_Value").length;
        var YesSelectCount = 0;
        $('.hygienelist').each(function (index, value) {
            //console.log('div' + index + ':' + $(this).attr('id'));
            //alert($(this).val);
            AllSelectCount++;
            if ($(this).find('option:selected').text()=='Yes')
            {
                ///alert($(this).find('option:selected').text());
                YesSelectCount++;
            }
        });
        //$("#ddlid option:selected").text();
        var value_hy = Math.round((YesSelectCount / AllSelectCount)*100);
        $(".hygienelist").val(value_hy);
        
       
        $('#hygienelist').modal('hide');
    }
