<script src="~/Scripts/jquery3_1.js"></script>
<script type="text/javascript">
    $(document).ready(function ()//When the dom is ready
    {

        //put Dealer city name in city span
        var Dealer_name1 = $("#Dealer_id_main :selected").text();
        var dealer_split = Dealer_name1.split("-");
        var dealer_city = dealer_split[1];
        //alert(dealer_city);
        $("#dealer_city").html(dealer_city);
        // fetch Dealer

        $("#Month_main").bind('change', function () {
            //alert('hello');
            var user1 = '@Session["Uid"].ToString()';//Get the value in the username textbox
            var Month = $("#Month_main").val();
            var url = '@Url.Action("GetDealer", "DropDown")';

            var url_com = url + "?user=" + user1 + "&Month=" + Month;
            // alert(url_com);

            $.getJSON(url_com, function (result) {

                var ddl = $('#Dealer_id_main');
                var data = result;
                ddl.empty();
                ddl.append(
                           $('<option/>', {
                               value: ''
                           }).html('Dealer'));
                $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {
                    ddl.append(
                          $('<option/>', {
                              value: item.Dealer_Code
                          }).html(item.Dealer_Name));
                    //dealer.val(item.Dealer_id);
                });

            });

            return false;
        });

        $("#Dealer_id_main").bind('change', function () {
            //alert('hello');
            var user1 = '@Session["Uid"].ToString()';//Get the value in the username textbox
            var Dealer = $("#Dealer_id_main").val();
            var url = '@Url.Action("GetDivision", "DropDown")';

            var url_com = url + "?user=" + user1 + "&Dealer=" + Dealer;
            // alert(url_com);

            $.getJSON(url_com, function (result) {

                var ddl = $('#OUT_main');
                var data = result;

                ddl.empty();
                ddl.append(
                           $('<option/>', {
                               value: ''
                           }).html('Division'));
                $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {
                    ddl.append(
                          $('<option/>', {
                              value: item.Division_Id + "/" + item.Dealer_Code
                          }).html(item.Division_Name));
                    //dealer.val(item.Dealer_id);
                });

            });

            return false;
        });

        // fetch LOB

        $("#OUT_main").bind('change', function () {
            var d_id = $("#OUT_main").val();//Get the value in the username textbox

            var res = d_id.split("/");
            //alert(res[0]);
            //alert(res[1]);
            var out_special = res[0].split("&")
            var out_id1 = out_special[0];
            var out_id2 = out_special[1];

            var url = '@Url.Action("GetLOB", "DropDown")';

            if (out_id2 == undefined) {
                var url_com = url + "?d_id1=" + out_id1 + "&d_id2=";
            }
            else {
                var url_com = url + "?d_id1=" + out_id1 + "&d_id2=" + out_id2;
            }


            //var url = '@*Url.Action("GetLOB", "DropDown")*@';

            //var url_com = url + "?d_id=" + res[0];
            //alert(url_com);

            $.getJSON(url_com, function (result) {

                var ddl = $('#LOB_main');
                var data = result;
           //alert(data);
                ddl.empty();
                ddl.append(
                           $('<option/>', {
                               value: ''
                           }).html('LOB'));
                $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {
                    ddl.append(
                          $('<option/>', {
                              value: item.LOB_ID
                          }).html(item.LOB));
                });

            });

            return false;
        });

    });

</script>
