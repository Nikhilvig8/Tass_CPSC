@using System.Configuration;
@{  cn = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;
     typeTSM = Session["Type"].ToString();
    string type = string.Empty;
    string OpMode = string.Empty;
    if (typeTSM == "AM" || typeTSM == "TSM" || typeTSM=="SLM")
    {
        type = "TSM";
        OpMode = "1";

    }
    else
    {

        type = "CSM";
        OpMode = "2";
    }

  
                                            <!-- Pending Inputs -->

    DataTable dtfTSM;
    string _sqlTSM = string.Empty;

    _sqlTSM = "procGetTSM_CSM";
    //var cmdTSM = new SqlCommand(_sqlTSM, cn);
    using (var cnTSM = new SqlConnection(cn))
    {
        var daCampusTSM = new SqlDataAdapter(_sqlTSM, cnTSM);
        DataTable dtTSM = new DataTable();
        daCampusTSM.SelectCommand.CommandType = CommandType.StoredProcedure;
        daCampusTSM.SelectCommand.Parameters.AddWithValue("@OpMode", OpMode);
        if (Session["Type"].ToString() == "AM" || Session["Type"].ToString() == "ASM" || Session["Type"].ToString() =="SLM" || Session["Type"].ToString() =="SSM" )
        {
            daCampusTSM.SelectCommand.Parameters.AddWithValue("@AM_ASM_Code", Session["Uid"].ToString());
        }
        //else { daCampusTSM.SelectCommand.Parameters.AddWithValue("@TSM_CSM_Code", Session["Uid"].ToString()); }
        daCampusTSM.SelectCommand.Parameters.AddWithValue("@Dealer_Code", Model.Trans.Dealer);
        daCampusTSM.SelectCommand.Parameters.AddWithValue("@Division_Id", Model.Trans.Out);
        daCampusTSM.SelectCommand.Parameters.AddWithValue("@LOB", Model.Trans.LOB);

        daCampusTSM.Fill(dtTSM);

        dtfTSM = dtTSM;
    }


}

