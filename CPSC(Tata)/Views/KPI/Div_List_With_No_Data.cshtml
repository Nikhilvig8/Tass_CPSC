
@{
    ViewBag.Title = "Div_List_With_No_Data";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/jquery3_1.js"></script>
<script>
    $(document).ready(function () {
        $('#divisionList').rowspanizer({ vertical_align: 'middle' });
    });

</script>
@using System.Data;
@using System.Data.SqlClient;
@using System.Globalization;
@using System.Web;
@using System.Configuration;
<!-- Pending Inputs -->
@{
    string uidPI = Session["Uid"].ToString();

    DataTable dtfBox;
    DataTable dtfDealer;
    string _sqlPI = string.Empty;
    string CS_index = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;

    using (SqlConnection cnPI = new SqlConnection(CS_index))
    {
        SqlDataAdapter da1 = new SqlDataAdapter("getDivWisePendingDataTarget", cnPI); // Using a Store Procedure.
                                                                                      //SqlDataAdapter da = new SqlDataAdapter("SELECT 'this is a test text' as test", con); To use a hard coded query.
        da1.SelectCommand.CommandType = CommandType.StoredProcedure; // Comment if using hard coded query.
        DataSet ds = new DataSet(); // Definition: Memory representation of the database.
        da1.SelectCommand.Parameters.AddWithValue("@Uid", uidPI); // Repeat for each parameter present in the Store Procedure.

        da1.Fill(ds); // Fill the dataset with the query data
        dtfBox = ds.Tables[0];
        //dtfDealer = ds.Tables[1];

    }
}


<div class="row">
    <div class="col-md-12">

        <div class="portlet light bordered" id="form_wizard_1">
            <div class="portlet-title" style="min-height:30px; margin-bottom:0px;">
                <div class="caption" style="padding:0px 0;">
                    @*<i class="icon-layers font-blue"></i>*@
                    <i class="glyphicon glyphicon-list-alt font-blue"></i>
                    <span class="caption-subject font-blue bold uppercase">
                        Division With No Data - Target
                    </span>
                </div>
                <div class="btn-group pull-right" style="margin-top: -8px;">
                    <button class="btn green btn-outline dropdown-toggle" data-toggle="dropdown">
                        Tools
                        <i class="fa fa-angle-down"></i>
                    </button>
                    <ul class="dropdown-menu pull-right">
                        @*<li>
                                <a id="Print"> Print </a>
                            </li>*@
                        <li>
                            <a id="ExcelExport"> Export to Excel </a>
                        </li>
                        @*<li>
                                <a id="Exporttopdf"> Export to Pdf </a>
                            </li>*@
                    </ul>
                </div>
            </div>
            <div class="portlet-body form">

                <div class="portlet-body">

                    <style>
                        #td {
                            font-size: 11px;
                        }

                        #th {
                            font-size: 11px;
                        }
                    </style>
                    <table class="table table-bordered table-striped" id="divisionList">
                        <thead>
                            <tr style="background-color:#ccc;">
                                <th id="th">TASS Code</th>
                                <th id="th">TASS Name</th>
                                <th id="th">Division</th>
                            </tr>
                        </thead>
                        <tbody>

                            @{
                                for (int i = 0; i < dtfBox.Rows.Count; i++)
                                {
                                    <tr>
                                        <td id="td">@dtfBox.Rows[i]["Dealer_Code"].ToString()</td>
                                        <td id="td">@dtfBox.Rows[i]["Dealer_Name"].ToString()</td>
                                        <td id="td">@dtfBox.Rows[i]["Division_Name"].ToString()</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" type="text/css" href="~/assets/apps/css/all.min.css" />


<script>

    $(document).ready(function () {



        $("#divisionList").dataTable({

            "bPaginate": false
        });


    });

    function printData()
{
        var divToPrint = document.getElementById("example");
        divToPrint.style.borderCollapse = "collapse";


        var th = document.getElementById("example").getElementsByTagName("th");

        for (i = 0; i < th.length; i++) {
            th[i].style.borderColor = "Black";
            th[i].style.borderWidth = "1px";
            th[i].style.borderStyle = "solid";
           // alert(i);
        }
        //th[11].innerHTML = "";
        var td = document.getElementById("example").getElementsByTagName("td");
        for (k = 0; k < td.length; k++) {
            td[k].style.borderColor = "Black";
            td[k].style.borderWidth = "1px";
            td[k].style.borderStyle = "solid";
        }
   newWin= window.open("");
   newWin.document.write(divToPrint.outerHTML);
   newWin.print();
   newWin.close();
   for (l = 0; l < th.length; l++) {
       th[l].style.borderColor = "";
       th[l].style.borderWidth = "";
       th[l].style.borderStyle = "";
   }
   //th[11].innerHTML = "Action";
   var td = document.getElementById("example").getElementsByTagName("td");
   for (m = 0; m < td.length; m++) {
       td[m].style.borderColor = "";
       td[m].style.borderWidth = "";
       td[m].style.borderStyle = "";
   }
}


$('#Print').on('click',function(){
printData();
})
$('#ExcelExport').on('click', function () {
    var proc = 'getDivWisePendingDataTarget';
    var flag = 'DealerList';
    var Uid = '@Session["Uid"].ToString()';
    var filename = 'Pending_TASS_List_Target_' + Uid + '.xlsx';

    var url_at = '@Url.Action("DTToExcel", "Home")';
    var url_com_at = url_at + '?Proc=' + proc + '&flag=' + flag + '&filename=' + filename;
    //alert(url_com_at);
    var jsonComp_at = $.getJSON(url_com_at, function (result) {

        if (result == true) {

            var uri_file = '@Url.Action("Download", "Home")';
            var uri_file_at = uri_file + '?file=' + filename;
            window.location.href = uri_file_at;
        }
        else {


        }

    });

    return (true);


})
</script>


