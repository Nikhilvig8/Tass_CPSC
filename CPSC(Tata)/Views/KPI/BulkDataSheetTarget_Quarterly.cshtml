<script nonce="@CspNonce.Current">

    function hygienelist(dealer, division, lob, input_id_hy, kpi_id_hy)
    {
        $('#hyModelBody').html("");
        var url1 = '@Url.Action("GetHyList", "DropDown")';
        var month_hy = $("#Month_main").val();
        var year_hy_txt = $("#Month_main option:selected").text();
        var year_hy_splt = year_hy_txt.split("-");
        var year_hy = year_hy_splt[0];
        var url_com1 = url1 + "?month=" + month_hy + "&year=" + year_hy + "&dealer=" + dealer + "&division=" + division + "&lob=" + lob;
        //alert(url_com1);


        $.getJSON(url_com1, function (result) {

            var data = result;
            //alert(data);
            var html = '<table class="table"><thead><tr><th class="col-md-1">No.</th><th class="col-md-8">Description</th><th class="col-md-3">&nbsp;</th></tr></thead><tbody><input type="hidden" name="input_id" id="input_id" value="' + input_id_hy + '" />';

            $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {

                if (item["Selection"] == "NO") {
                    html += ('<tr><td class="col-md-1">' + item["SerialNo"] + '</td><td class="col-md-8"><span style="">' + item["Description"] + '</span><td class="col-md-3"><select id="Select_Value" name="Select_Value" class="form-control Select_Value hygiene ' + input_id_hy + '" style="margin-bottom:2px;"><option value="' + item["SerialNo"] + '<<>>' + item["Description"] + '" selected>No</option><option value="' + item["SerialNo"] + '<<>>' + item["Description"] + '" >Yes</option></select></td></tr>');
                }
                else if (item["Selection"] == "YES") {
                    html += ('<tr><td class="col-md-1">' + item["SerialNo"] + '</td><td class="col-md-8"><span style="">' + item["Description"] + '</span><td class="col-md-3"><select id="Select_Value" name="Select_Value" class="form-control Select_Value hygiene ' + input_id_hy + '" style="margin-bottom:2px;"><option value="' + item["SerialNo"] + '<<>>' + item["Description"] + '" >No</option><option value="' + item["SerialNo"] + '<<>>' + item["Description"] + '" selected>Yes</option></select></td></tr>');
                }
                else {
                    html += ('<tr><td class="col-md-1">' + item["SerialNo"] + '</td><td class="col-md-8"><span style="">' + item["Description"] + '</span><td class="col-md-3"><select id="Select_Value" name="Select_Value" class="form-control Select_Value hygiene ' + input_id_hy + '" style="margin-bottom:2px;"><option value="' + item["SerialNo"] + '<<>>' + item["Description"] + '">No</option><option value="' + item["SerialNo"] + '<<>>' + item["Description"] + '" >Yes</option></select></td></tr>');
                }


            });
            html += '</tbody></table>';
            html += '</div><div class="modal-footer"><a class="btn green button-submit" onclick="onhygienelistclose(\'' + input_id_hy + '\', \'' + month_hy + '\', \'' + year_hy + '\', \'' + dealer + '\', \'' + division + '\', \'' + lob + '\', \'' + kpi_id_hy + '\')">Submit</a></div>';
            //alert(html);
            $('#hyModelBody').append(html);
        });
        //var submit_hy = '<a class="btn green button-submit" onclick="onhygienelistclose(\'' + input_id_hy + '\', \'' + month_hy + '\', \'' + year_hy + '\', \'' + dealer + '\', \'' + division + '\', \'' + lob + '\', \'' + kpi_id_hy + '\')">Submit</a>';
        //$('#hygieneSubmit').append(submit_hy);
    }

    function dselist(dealer, division, lob, input_id_dse, kpi_id_dse)
    {
        //alert(dealer + ', '+ division +', '+ lob);
        $('#dseModelBody').html("");
        var url1 = '@Url.Action("GetDSEList", "DropDown")';
        var month_dse = $("#Month_main").val();
        var year_des_txt = $("#Month_main option:selected").text();
        var year_splt = year_des_txt.split("-");
        var year_dse = year_splt[0];
        var url_com1 = url1 + "?month=" + month_dse + "&year=" + year_dse + "&dealer=" + dealer + "&division=" + division + "&lob=" + lob;
        //alert(url_com1);

        $.getJSON(url_com1, function (result) {

            var data = result;
            //alert(data);
            var html = '<table class="table"><thead><tr><th class="col-md-1">Id</th><th class="col-md-8">Description</th><th class="col-md-3">&nbsp;</th></tr></thead><tbody><input type="hidden" name="input_id" id="input_id" value="' + input_id_dse + '" />';

            $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {

                if (item["Selection"] == "NO")
                {
                    html += ('<tr><td class="col-md-3">' + item["DSE_ID"] + '</td><td class="col-md-6"><span style="">' + item["DSE_Name"] + '</span><td class="col-md-3"><select id="Select_Value" name="Select_Value" class="form-control Select_Value ' + input_id_dse + '" style="margin-bottom:2px;"><option value="' + item["DSE_ID"] + '<<>>' + item["DSE_Name"] + '" selected>No</option><option value="' + item["DSE_ID"] + '<<>>' + item["DSE_Name"] + '" >Yes</option></select></td></tr>');
                }
                else if(item["Selection"] == "YES")
                {
                    html += ('<tr><td class="col-md-3">' + item["DSE_ID"] + '</td><td class="col-md-6"><span style="">' + item["DSE_Name"] + '</span><td class="col-md-3"><select id="Select_Value" name="Select_Value" class="form-control Select_Value ' + input_id_dse + '" style="margin-bottom:2px;"><option value="' + item["DSE_ID"] + '<<>>' + item["DSE_Name"] + '" >No</option><option value="' + item["DSE_ID"] + '<<>>' + item["DSE_Name"] + '" selected>Yes</option></select></td></tr>');
                }
                else
                {
                    html += ('<tr><td class="col-md-3">' + item["DSE_ID"] + '</td><td class="col-md-6"><span style="">' + item["DSE_Name"] + '</span><td class="col-md-3"><select id="Select_Value" name="Select_Value" class="form-control Select_Value ' + input_id_dse + '" style="margin-bottom:2px;"><option value="' + item["DSE_ID"] + '<<>>' + item["DSE_Name"] + '">No</option><option value="' + item["DSE_ID"] + '<<>>' + item["DSE_Name"] + '" >Yes</option></select></td></tr>');
                }


