@{ string cn = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;
    string typeTSM = Session["Type"].ToString();
    string type = string.Empty;
    string OpMode = string.Empty;
    if (typeTSM == "AM" || typeTSM == "TSM" || typeTSM=="SLM")
    {
        type = "TSM";
        OpMode = "1";

    }
    else
    {

        type = "CSM";
        OpMode = "2";
    }

}
