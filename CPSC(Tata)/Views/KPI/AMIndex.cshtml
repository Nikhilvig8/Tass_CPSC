<script src="~/Scripts/jquery3_1.js"></script>
<script type="text/javascript" nonce="@CspNonce.Current">
$(document).ready(function()//When the dom is ready
{
    var month_as = $("#Month").val();
    var year_as = "@DateTime.Now.Year.ToString()";
    var user_id_as = "@Session["Uid"].ToString()";
    var sheet_as = "Target";
    var url_as = '@Url.Action("GetDataEntryPoint", "DropDown")';

    var url_com_as = url_as + "?month_as=" + month_as + "&year_as=" + year_as + "&user_id_as=" + user_id_as + "&sheet_as=" + sheet_as;
    //alert(url_com_as);

    $.getJSON(url_com_as, function (result_as)
    {
        var data_as = result_as;
        var dealer_as = "";
        var division_as = "";
        var lob_as = "";
        $.each(eval(data_as.replace(/[\r\n]/, "")), function (i, item) {
            
            dealer_as += "<option value='" + item.Dealer_Code + "' selected='selected'>" + item.Dealer_Name + "</option>";
            division_as += "<option value='" + item.Division_Id + "/" + item.Dealer_Code + "' selected='selected'>" + item.Division_Name + "</option>";
            lob_as += "<option value='" + item.LOB_ID + "' selected='selected'>" + item.LOB + "</option>";

            //$('#Dealer').val(item.Dealer_Code);
            //$('#Out').val(item.Division_Id + "/" + item.Dealer_Code);
            //$('#lob').val(item.LOB_ID);
            //alert(dealer_as);
            $('#Dealer').html(dealer_as);
            $('#Out').html(division_as);
            $('#lob').html(lob_as);
            document.AMTarget.submit();
        });
        

        

    });

    

    //return false;


    @*$("#Month").bind('change', function () {
        //alert('hello');
        var user1 = '@Session["Uid"].ToString()';//Get the value in the username textbox
        var Month = $("#Month").val();
        var url = '@Url.Action("GetDealer", "DropDown")';

        var url_com = url + "?user=" + user1 + "&Month=" + Month;
        // alert(url_com);

        $.getJSON(url_com, function (result) {

            var ddl = $('#Dealer');
            var data = result;
            ddl.empty();
            ddl.append(
                       $('<option/>', {
                           value: ''
                       }).html('Dealer'));
            $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {
                ddl.append(
                      $('<option/>', {
                          value: item.Dealer_Code
                      }).html(item.Dealer_Name));
                //dealer.val(item.Dealer_id);
            });

        });

        return false;
    });


        // fetch Division


    $("#Dealer").bind('change', function () {
        //alert('hello');
        var user1 = '@Session["Uid"].ToString()';//Get the value in the username textbox
        var Dealer = $("#Dealer").val();
        var url = '@Url.Action("GetDivision", "DropDown")';

        var url_com = url + "?user=" + user1 + "&Dealer=" + Dealer;
       // alert(url_com);

        $.getJSON(url_com, function (result) {

            var ddl = $('#Out');
            var data = result;
            ddl.empty();
            ddl.append(
                       $('<option/>', {
                           value: ''
                       }).html('Division'));
            $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {
                ddl.append(
                      $('<option/>', {
                          value: item.Division_Id+"/"+item.Dealer_Code
                      }).html(item.Division_Name));
                //dealer.val(item.Dealer_id);
            });

        });

        return false;
    });

    // fetch LOB

    $("#Out").bind('change', function () {
        var d_id = $("#Out").val();//Get the value in the username textbox

        var res = d_id.split("/");
        //alert(res[0]);
        //alert(res[1]);
        var out_special = res[0].split("&")
        var out_id1 = out_special[0];
        var out_id2 = out_special[1];

        var url = '@Url.Action("GetLOB", "DropDown")';

        if (out_id2 == undefined) {
            var url_com = url + "?d_id1=" + out_id1 + "&d_id2=";
        }
        else {
            var url_com = url + "?d_id1=" + out_id1 + "&d_id2=" + out_id2;
        }


        //var url = '@Url.Action("GetLOB", "DropDown")';

        //var url_com = url + "?d_id=" + res[0];
        //alert(url_com);
        
        $.getJSON(url_com, function (result) {

            var ddl = $('#lob');
            var data = result;
            ddl.empty();
            ddl.append(
                       $('<option/>', {
                           value: ''
                       }).html('LOB'));
            $.each(eval(data.replace(/[\r\n]/, "")), function (i, item) {
                ddl.append(
                      $('<option/>', {
                          value: item.LOB_ID
                      }).html(item.LOB));
            });

        });

        return false;
    });*@

});

</script>
@using System.Data;
