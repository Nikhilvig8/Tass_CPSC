
@{
    Layout = null;
}
@using System.Data;
@using System.Data.SqlClient;
@using System.Globalization;
@using System.Web;
@using System.Configuration;
@{ string cn = ConfigurationManager.ConnectionStrings["constr"].ConnectionString;
    string typeTSM = Session["Type"].ToString();
                                            <!-- Pending Inputs -->

    DataTable dtfHy;
    string _sqlHy = string.Empty;

    _sqlHy = "getHygienList";
    //var cmdTSM = new SqlCommand(_sqlTSM, cn);
    using (var cnHy = new SqlConnection(cn))
    {
        var daCampusHy = new SqlDataAdapter(_sqlHy, cnHy);
        DataTable dtHy = new DataTable();
        daCampusHy.SelectCommand.CommandType = CommandType.StoredProcedure;

        //else { daCampusTSM.SelectCommand.Parameters.AddWithValue("@TSM_CSM_Code", Session["Uid"].ToString()); }
        //daCampusTSM.SelectCommand.Parameters.AddWithValue("@Dealer_Code", Model.Trans.Dealer);
        //daCampusTSM.SelectCommand.Parameters.AddWithValue("@Division_Id", Model.Trans.Out);
        //daCampusTSM.SelectCommand.Parameters.AddWithValue("@LOB", Model.Trans.LOB);

        daCampusHy.Fill(dtHy);

        dtfHy = dtHy;
    }


}


