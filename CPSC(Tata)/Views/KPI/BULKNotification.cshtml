    function onciauditlistclose(input_id_ciaudit, month_ciaudit, year_ciaudit, dealer_ciaudit, division_ciaudit, lob_ciaudit, kpi_ciaudit) {
        var AllSelectCount = 0; //$(".Select_Value").length;
        var YesSelectCount = 0;
        //alert($('#' + input_id_hy).val());
        $('#' + input_id_ciaudit).val("");
        //alert(input_id_hy);
        var countWeight = 0;
        var countGrp1 = 0;
        var countGrp2 = 0;
        var countGrp3 = 0;
        var countGrp4 = 0;
        $('.ciaudit').each(function (index, value) {
            //console.log('div' + index + ':' + $(this).attr('id'));
            //alert($(this).val);
            AllSelectCount++;

           
            if ($(this).find('option:selected').text() == 'Yes') {

                var Audit_details = $(this).find('option:selected').val();
                var Audit_details_split = Audit_details.split("<<>>");
                var Audit_id_audit = Audit_details_split[0];
                var Audit_name_audit = Audit_details_split[1];
                var Audit_name_Weightage = Audit_details_split[2];
                //alert(month_dse + "," + year_dse + "," + dealer_dse + "," + division_dse + "," + lob_dse + "," + kpi_dse + "," + DES_id_dse + "," + DES_name_dse +", YES");

                var url_ciaudit = '@Url.Action("TempCIAuditListData", "DropDown")';
                //month, string year, string dealer_code, string division_id, string lob_id,string KPI,string DSE_id,string DSE_name,string Selection
                var url_com_ciaudit = url_ciaudit + "?month=" + month_ciaudit + "&year=" + year_ciaudit + "&dealer_code=" + dealer_ciaudit + "&division_id=" + division_ciaudit + "&lob_id=" + lob_ciaudit + "&KPI=" + kpi_ciaudit + "&Serial_No=" + Audit_id_audit + "&Desc=" + Audit_name_audit + "&Weightage=" + Audit_name_Weightage + "&Selection=YES";

                var jsonComp_dse = $.getJSON(url_com_ciaudit, function (result) {
                    //alert(result);
                });

                ///alert($(this).find('option:selected').text());
                YesSelectCount++;

               

                if (Audit_id_audit.substring(0, 1) == "1") {
                    countGrp1 += parseInt(Audit_name_Weightage);
                }
                else if (Audit_id_audit.substring(0, 1) == "2") {
                    countGrp2 += parseInt(Audit_name_Weightage);
                }
                else if (Audit_id_audit.substring(0, 1) == "3") {
                    countGrp3 += parseInt(Audit_name_Weightage);
                }
                else if (Audit_id_audit.substring(0, 1) == "4") {
                    countGrp4 += parseInt(Audit_name_Weightage);
                }
                //   Audit_name_Weightage++;
            }
        });


        countGrp1 = (35 * countGrp1) / 100;
        countGrp2 = (40 * countGrp2) / 100;
        countGrp3 = (10 * countGrp3) / 100;
        countGrp4 = (15 * countGrp4) / 100;

        // alert(countGrp1 + "==" + countGrp2 + "==" + countGrp3 + "==" + countGrp4);
        //$("#ddlid option:selected").text();

        var value_ciaudit = Math.round((countGrp1 + countGrp2 + countGrp3 + countGrp4));
